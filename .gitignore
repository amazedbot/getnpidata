# Build output
[Bb]in/
[Oo]bj/
[Aa]rtifacts/
[Tt]est[Rr]esults/
*.binlog
*.dll
*.exe
*.pdb
*.nupkg
*.snupkg

# IDE and user files
.vs/
.vscode/*
# Shared VS Code setup: the C# Dev Kit and the solution to open.
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.user
*.suo
*.DotSettings.user

# Local config and secrets (connection strings, HUD token, API keys) never go in git;
# use user-secrets, environment variables or these git-ignored files.
appsettings.Local.json
appsettings.*.Local.json
*.cnf

# Loader working folders, logs and downloaded data (only hand-made fixtures are tracked)
[Ww]ork/
[Ll]ogs/
*.log
*.zip
*.xlsx
!tests/fixtures/**

# Published copies the scripts run (scripts/site.ps1, scripts/loader.ps1), so builds never collide with a running site
.run/

# docker compose passwords (copy .env.example)
.env
