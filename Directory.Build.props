<Project>
  <!-- Shared settings for every SDK-style project in the repo (the legacy VB project is not SDK-style and ignores this). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Authors>getnpidata</Authors>
    <Product>getnpidata</Product>
  </PropertyGroup>
</Project>
