@page "/facility/{ccn}"
@using System.Globalization
@using Npi.Core.Search
@model FacilityModel
@{
    var p = Model.Profile;
    var f = Model.Facility;
    ViewData["Title"] = Model.Name;
}

@section Scripts {
    <script src="~/js/profile.js" asp-append-version="true" defer></script>
}

<div class="profile">
    <nav aria-label="Breadcrumb" class="crumbs"><a href="/facilities">Facilities &amp; hospitals</a> › <a href="/facilities?type=@f.Kind">@Npi.Core.Search.FacilityTypes.Get(f.Kind).Plural</a></nav>

    <section class="card profile-head" aria-labelledby="who">
        <div class="head-row">
            <svg class="avatar-lg org" role="img" aria-label="@Model.KindName" viewBox="0 0 104 104">
                <circle cx="52" cy="52" r="52" class="bg" />
                <path d="M32 80V26h40v54M48 40h8M52 36v8M44 80V64h16v16" fill="none" class="stroke" stroke-width="4" stroke-linejoin="round" />
            </svg>
            <div class="head-main">
                <h1 id="who">@Model.Name</h1>
                <p class="summary">@Model.Summary</p>
                <ul class="pills" aria-label="Status">
                    @if (p.Certification is { Active: false } ended)
                    {
                        <li class="pill alert">Certification ended@(ended.TerminationDate is { } d ? " " + d.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) : "")</li>
                    }
                    else
                    {
                        <li class="pill ok">Medicare certified</li>
                    }
                    @if (f.EmergencyServices == true){<li class="pill plain">Emergency services</li>}
                    <li class="pill plain">CMS ID <span class="mono">&nbsp;@f.Ccn</span></li>
                </ul>
            </div>
            <div class="head-actions">
                @if (f.Phone is not null){<a class="button secondary" href="tel:@f.Phone">Call @Format.Phone(f.Phone)</a>}
                <a class="button" href="/facility/@f.Ccn/raw.json" download>Download raw data</a>
            </div>
        </div>
        <p class="head-facts">
            <span>@Model.KindName</span>
            @if (f.Ownership is not null){<span>Ownership: @f.Ownership</span>}
            @if (p.Dialysis?.Chain is { } chain){<span>Chain: @chain</span>}
            @if (f.CertifiedBeds is { } beds){<span>@beds.ToString("N0", CultureInfo.InvariantCulture) certified beds</span>}
            @if (p.Dialysis is { } dia)
            {
                var services = new[] { (dia.InCenterHemodialysis, "in-center hemodialysis"), (dia.PeritonealDialysis, "peritoneal dialysis"), (dia.HomeHemodialysisTraining, "home hemodialysis training") }
                    .Where(x => x.Item1 == true).Select(x => x.Item2).ToList();
                if (services.Count > 0){<span>Offers @string.Join(", ", services)</span>}
            }
            @if (p.CertifiedSince is { } since){<span>Medicare certified since @since.ToString("MMMM yyyy", CultureInfo.InvariantCulture)</span>}
        </p>
    </section>

    @if (p.CertificationOnly)
    {
        <section class="card" aria-labelledby="cert-h">
            <h2 id="cert-h">Medicare certification</h2>
            <dl class="facts">
                <dt>Type</dt><dd>@Model.KindName</dd>
                <dt>CMS Certification Number</dt><dd class="mono">@f.Ccn</dd>
                <dt>Status</dt>
                <dd>@if (p.Certification is { Active: false } c){<text>Ended@(c.TerminationDate is { } d ? " on " + d.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture) : "")@(c.TerminationReason is { } why ? $" ({why.ToLowerInvariant()})" : "")</text>}else{<text>Certified</text>}</dd>
            </dl>
            <p class="src">CMS Provider of Services file. Medicare Care Compare doesn't rate this kind of facility, so there are no star ratings, ownership or phone here.</p>
        </section>
    }
    else if (Model.Ratings.Any())
    {
    <section class="card" aria-labelledby="ratings-h">
        <h2 id="ratings-h">How CMS rates it</h2>
        <div class="tiles">
            @foreach (var r in Model.Ratings)
            {
                <div class="tile">
                    <span class="label">@r.Label</span>
                    @if (r.Stars is { } stars)
                    {
                        var full = (int)Math.Floor(stars);
                        var half = stars - full >= 0.5;
                        <span class="stars" role="img" aria-label="@stars.ToString("0.#", CultureInfo.InvariantCulture) out of 5 stars">@(new string('★', full))@(half ? "½" : "")<span class="off">@(new string('★', 5 - full - (half ? 1 : 0)))</span></span>
                        <span class="small">@stars.ToString("0.#", CultureInfo.InvariantCulture) of 5 stars · @r.Note</span>
                    }
                    else
                    {
                        <strong class="@(r.Bad ? "bad" : null)">@r.Value</strong>
                        <span class="small">@r.Note</span>
                    }
                </div>
            }
        </div>
        <p class="src">Medicare Care Compare.@if (f.Kind == "hospital"){<text> Deaths, safety and readmissions count the measures CMS rates better or worse than the national rate; the rest are no different.</text>}</p>
    </section>
    }

    @if (p.Measures.Count > 0)
    {
        <section class="card" aria-labelledby="cmp-h">
            <h2 id="cmp-h">How it compares</h2>
            @foreach (var g in Model.MeasureGroups)
            {
                <h3>@g.Key</h3>
                <div class="table-wrap">
                    <table class="measures">
                        <caption class="visually-hidden">@g.Key: this facility, the national value and CMS's comparison</caption>
                        <thead>
                            <tr><th scope="col">Measure</th><th scope="col">This facility</th><th scope="col">US</th><th scope="col">CMS compares it as</th><th scope="col">Period</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var m in g)
                            {
                                <tr>
                                    <th scope="row">@m.Measure.Name@if (m.Measure.Cases is { } cases){<br /><span class="muted small">@Format.Number(cases) @(m.Measure.Group == FacilityMeasures.PatientExperience ? "completed surveys" : "patients or cases")</span>}</th>
                                    <td class="nowrap">@m.Value</td>
                                    <td class="nowrap">@m.National</td>
                                    <td>@if (m.Comparison is not null){<span class="@m.PillClass">@m.Comparison</span>}else{<span class="muted">Not compared</span>}</td>
                                    <td class="nowrap small">@m.Period</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <p class="src">@Model.MeasureSource</p>
        </section>
    }

    @if (p.QualityIncentive is { } qip)
    {
        <section class="card" aria-labelledby="qip-h">
            <h2 id="qip-h">Medicare quality incentive (ESRD QIP, payment year @qip.PaymentYear)</h2>
            <div class="tiles">
                <div class="tile"><span class="label">Total performance score</span><strong>@(qip.TotalPerformanceScore is { } score ? $"{score} of 100" : "No score")</strong><span class="small">@Model.QipAverages</span></div>
                <div class="tile"><span class="label">Payment reduction</span><strong>@(qip.PaymentReduction is { } cut ? cut.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) + "%" : "—")</strong><span class="small">@(qip.PaymentReduction is 0.0 ? "No cut to its Medicare payments" : "Cut to its Medicare payments for the year")</span></div>
            </div>
            <p class="src">Medicare Care Compare: ESRD QIP – Total Performance Scores – Payment Year @qip.PaymentYear. The score (0–100) combines the program's clinical, safety, patient experience and reporting measures; facilities below CMS's minimum score have their Medicare payments cut by up to 2% for that year.</p>
        </section>
    }

    @if (p.MedicareVolume is { } v)
    {
        <section class="card" aria-labelledby="vol-h">
            <h2 id="vol-h">Medicare volume</h2>
            <div class="tiles">
                @if (v.Discharges is { } discharges){<div class="tile"><span class="label">Inpatient stays@(v.InpatientYear is { } iy ? $" ({iy})" : "")</span><strong>@Format.Number(discharges)</strong><span class="small">Medicare discharges</span></div>}
                @if (v.Beneficiaries is { } benes){<div class="tile"><span class="label">Inpatients</span><strong>@Format.Number(benes)</strong><span class="small">Medicare patients</span></div>}
                @if (v.CoveredDays is { } days){<div class="tile"><span class="label">Covered days</span><strong>@Format.Number(days)</strong><span class="small">in the hospital</span></div>}
                @if (v.MedicarePayments is { } paid){<div class="tile"><span class="label">Medicare paid, inpatient</span><strong>@Format.ShortMoney(paid)</strong><span class="small">@(v.TotalPayments is { } total ? $"{Format.ShortMoney(total)} with patients' and other payers' shares" : "Medicare's share")</span></div>}
                @if (v.OutpatientServices is { } svc){<div class="tile"><span class="label">Outpatient services@(v.OutpatientYear is { } oy ? $" ({oy})" : "")</span><strong>@Format.Number(svc)</strong><span class="small">in the service groups CMS lists</span></div>}
                @if (v.OutpatientPayments is { } outPaid){<div class="tile"><span class="label">Medicare paid, outpatient</span><strong>@Format.ShortMoney(outPaid)</strong><span class="small">for those services</span></div>}
            </div>
            @foreach (var (title, caption, list, unit) in new[] { ("Most frequent inpatient stays (DRGs)", "DRG", v.TopInpatient, "Discharges"), ("Most frequent outpatient services (APCs)", "APC", v.TopOutpatient, "Services") })
            {
                if (list.Count == 0)
                {
                    continue;
                }
                <h3>@title</h3>
                <div class="table-wrap">
                    <table>
                        <caption class="visually-hidden">@title, most cases first</caption>
                        <thead><tr><th scope="col">@caption</th><th scope="col">@unit</th><th scope="col">Avg. Medicare payment</th></tr></thead>
                        <tbody>
                            @foreach (var x in list)
                            {
                                <tr>
                                    <th scope="row"><span class="mono">@x.Code</span> @x.Description</th>
                                    <td>@Format.Number(x.Cases)</td>
                                    <td>@(x.AverageMedicarePayment is { } avg ? Format.Money(avg) : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <p class="src">@Model.VolumeSource</p>
        </section>
    }

    <partial name="_FacilityOwnership" model="new FacilityOwnershipSection(Model.Ownership, FacilityModel.IsNursingHome(f) ? Npi.Core.Search.FacilityTypes.NursingHome : f.Kind)" />

    @if (Model.Inspections is { } inspections)
    {
        <partial name="_NursingHomeInspections" model="inspections" />
    }

    <div class="profile-row">
        <div class="grow">
            <partial name="_ClinicianList" model="Model.Clinicians" />
        </div>
        <section class="card side-card" aria-labelledby="loc-h">
            <h2 id="loc-h">Location</h2>
            @if (Model.Map is { } map)
            {
                <div class="static-map small-map">
                    @foreach (var t in map.Tiles)
                    {
                        <img src="@t.Url" alt="" loading="lazy" decoding="async" referrerpolicy="strict-origin-when-cross-origin"
                             style="left:@(StaticMap.Css(t.LeftPercent))%;top:@(StaticMap.Css(t.TopPercent))%;width:@(StaticMap.Css(t.WidthPercent))%;height:@(StaticMap.Css(t.HeightPercent))%" />
                    }
                    @foreach (var pin in map.Pins)
                    {
                        <span class="pin" style="left:@(StaticMap.Css(pin.LeftPercent))%;top:@(StaticMap.Css(pin.TopPercent))%" aria-hidden="true">●</span>
                    }
                </div>
                <p class="src">@Html.Raw(Model.Attribution)</p>
            }
            <p>@(p.Address is null ? null : Npi.Core.Search.CityCatalog.TitleCase(p.Address))<br />@(f.City is null ? null : Npi.Core.Search.CityCatalog.TitleCase(f.City)), @f.State @p.Zip</p>
            @if (f.Phone is not null){<p><a href="tel:@f.Phone">@Format.Phone(f.Phone)</a></p>}
        </section>
    </div>

    <section class="card" aria-labelledby="npis-h">
        <h2 id="npis-h">Billing NPIs (@p.BillingNpis.Count)</h2>
        @if (p.BillingNpis.Count == 0)
        {
            <p>No active NPI is linked to this facility in CMS's enrollment files.</p>
        }
        else
        {
            <ul class="link-list">
                @foreach (var o in p.BillingNpis)
                {
                    <li><a href="/provider/@o.Npi">@o.Name</a> <span class="muted">@(o.Specialty)@(o.City is null ? "" : $" · {Npi.Core.Search.CityCatalog.TitleCase(o.City)}, {o.State}") · <span class="mono">@o.Npi</span></span></li>
                }
            </ul>
        }
        <p class="src">CMS hospital, nursing home, home health, hospice, FQHC and rural health clinic enrollments (CCN to NPI), the Medicare Dialysis Facility Report and Care Compare's surgery center file.</p>
    </section>
</div>
