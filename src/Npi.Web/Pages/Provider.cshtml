@page "/provider/{npi}"
@using System.Globalization
@model ProviderModel
@{
    var p = Model.Provider;
    ViewData["Title"] = p.Name;
}

<p><a href="javascript:history.back()">‹ Back to results</a></p>

<h1>@p.Name@if (p.Credential is not null){<span class="muted">, @p.Credential</span>}</h1>

<dl class="facts">
    <dt>NPI</dt><dd>@p.Npi</dd>
    <dt>Type</dt><dd>@p.EntityTypeName</dd>
    @if (p.Gender is not null)
    {
        <dt>Gender</dt><dd>@(p.Gender == "F" ? "Female" : p.Gender == "M" ? "Male" : p.Gender)</dd>
    }
    <dt>Enumerated</dt><dd>@p.EnumerationDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</dd>
    <dt>Last updated</dt><dd>@p.LastUpdateDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</dd>
</dl>

<h2>Specialties</h2>
<div class="table-wrap">
    <table>
        <thead><tr><th scope="col">Taxonomy</th><th scope="col">Classification</th><th scope="col">Specialization</th><th scope="col">Primary</th><th scope="col">License</th><th scope="col">License state</th></tr></thead>
        <tbody>
            @foreach (var t in p.Taxonomies)
            {
                <tr>
                    <td><a href="/?taxonomy=@t.Code">@t.Code</a></td>
                    <td>@t.Classification</td>
                    <td>@t.Specialization</td>
                    <td>@(t.IsPrimary ? "Yes" : "")</td>
                    <td>@t.LicenseNumber</td>
                    <td>@t.LicenseState</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<h2>Practice locations</h2>
<div class="table-wrap">
    <table>
        <thead><tr><th scope="col">Location</th><th scope="col">Address</th><th scope="col">City</th><th scope="col">State</th><th scope="col">ZIP</th><th scope="col">Phone</th></tr></thead>
        <tbody>
            @foreach (var l in p.Locations)
            {
                <tr>
                    <td>@(l.IsPrimary ? "Primary" : "Secondary")</td>
                    <td>@l.Address1@if (l.Address2 is not null){<br />@l.Address2}</td>
                    <td>@l.City</td>
                    <td>@l.State</td>
                    <td>@l.Zip@if (l.CountryCode is not null && l.CountryCode != "US"){<span class="muted"> (@l.CountryCode)</span>}</td>
                    <td>@Format.Phone(l.Phone)</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (p.Profile is { } profile && (profile.AuthorizedOfficial is not null || profile.ParentOrganization is not null || profile.MailingAddress is not null
                                   || profile.IsSoleProprietor == true || profile.PracticeFax is not null))
{
    <h2>Registration details</h2>
    <dl class="facts">
        @if (profile.AuthorizedOfficial is { } official)
        {
            <dt>Authorized official</dt>
            <dd>
                @official.Name@if (official.Credential is not null){<span>, @official.Credential</span>}
                @if (official.Title is not null){<br /><span class="muted">@official.Title</span>}
                @if (official.Phone is not null){<br />@Format.Phone(official.Phone)}
            </dd>
        }
        @if (profile.ParentOrganization is not null)
        {
            <dt>Parent organization</dt><dd>@profile.ParentOrganization@if (profile.IsOrganizationSubpart == true){<span class="muted"> (this NPI is a subpart)</span>}</dd>
        }
        @if (profile.IsSoleProprietor == true)
        {
            <dt>Sole proprietor</dt><dd>Yes</dd>
        }
        @if (profile.MailingAddress is { } mail)
        {
            <dt>Mailing address</dt>
            <dd>
                @mail.Address1@if (mail.Address2 is not null){<br />@mail.Address2}<br />
                @mail.City, @mail.State @mail.PostalCode@if (mail.CountryCode is not null && mail.CountryCode != "US"){<span> @mail.CountryCode</span>}
                @if (mail.Phone is not null){<br /><span>Phone @Format.Phone(mail.Phone)</span>}
                @if (mail.Fax is not null){<br /><span>Fax @Format.Phone(mail.Fax)</span>}
            </dd>
        }
        @if (profile.PracticeFax is not null)
        {
            <dt>Practice fax</dt><dd>@Format.Phone(profile.PracticeFax)</dd>
        }
    </dl>
}

@if (p.Endpoints.Count > 0)
{
    <h2>Electronic endpoints</h2>
    <div class="table-wrap">
        <table>
            <thead><tr><th scope="col">Type</th><th scope="col">Endpoint</th><th scope="col">Use</th><th scope="col">Affiliation</th></tr></thead>
            <tbody>
                @foreach (var e in p.Endpoints)
                {
                    <tr>
                        <td>@(e.TypeDescription ?? e.Type)</td>
                        <td class="break">@e.Endpoint@if (e.Description is not null){<br /><span class="muted">@e.Description</span>}</td>
                        <td>@e.Use</td>
                        <td>@e.AffiliationName@if (e.AffiliationCity is not null){<br /><span class="muted">@e.AffiliationCity, @e.AffiliationState</span>}</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (p.Identifiers.Count > 0)
{
    <h2>Other identifiers</h2>
    <div class="table-wrap">
        <table>
            <thead><tr><th scope="col">Identifier</th><th scope="col">Type</th><th scope="col">State</th><th scope="col">Issuer</th></tr></thead>
            <tbody>
                @foreach (var i in p.Identifiers)
                {
                    <tr><td>@i.Identifier</td><td>@i.Type</td><td>@i.State</td><td>@i.Issuer</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@if (p.OtherNames.Count > 0)
{
    <h2>Other names</h2>
    <ul>
        @foreach (var n in p.OtherNames)
        {
            <li>@n</li>
        }
    </ul>
}

<p class="muted">Verify details with the official <a href="https://npiregistry.cms.hhs.gov/provider-view/@p.Npi">NPPES NPI Registry</a>.</p>
