@page "/provider/{npi}"
@using System.Globalization
@using Npi.Core.Search
@model ProviderModel
@*
    The provider profile (docs/PRODUCT_PLAN.md step 1.4): summary card, map preview and plain specialty, then sections in the
    order people ask. A deactivated NPI shows only "Deactivated on [date]".
*@
@if (Model.Deactivated)
{
    ViewData["Title"] = $"NPI {Model.Npi}: deactivated";
    <section class="card profile-status" aria-labelledby="status">
        <h1 id="status">NPI <span class="mono">@Model.Npi</span></h1>
        <p><span class="pill alert">@(Model.DeactivationDate is { } d ? "Deactivated on " + d.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture) : "Deactivated")</span></p>
        <p>This NPI is no longer active in the national provider registry (NPPES). NPPES publishes nothing else about a deactivated NPI,
            so we can't show its name. Claims or prescriptions under it shouldn't be accepted.</p>
        @if (Model.LastKnown is { } last && Model.DeactivatedHistory is { } dh)
        {
            <h2>Last known record</h2>
            <dl class="facts">
                <dt>Practice location</dt><dd>@(last.Practice?.ToString() ?? "not listed")</dd>
                @if (last.SecondaryLocations.Count > 0)
                {
                    <dt>Other practice locations</dt><dd>@string.Join("; ", last.SecondaryLocations)</dd>
                }
                <dt>Primary specialty</dt><dd>@(last.PrimarySpecialty ?? "not listed")</dd>
                <dt>Entity type</dt><dd>@(last.EntityType == 2 ? "Organization" : last.EntityType == 1 ? "Individual" : "not listed")</dd>
                @if (last.EnumerationDate is { } issuedOn)
                {
                    <dt>NPI issued</dt><dd>@issuedOn.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</dd>
                }
                @if (last.LastUpdateDate is { } updated)
                {
                    <dt>Last updated</dt><dd>@updated.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</dd>
                }
                <dt>Listed as such</dt><dd>@last.ListedFrom.ToString("MMMM yyyy", CultureInfo.InvariantCulture)@(last.ListedTo is { } until ? " to " + until.ToString("MMMM yyyy", CultureInfo.InvariantCulture) : "")</dd>
            </dl>
            <p class="src">From the archived monthly NPPES files (@ProviderHistory.Attribution, <a href="@ProviderHistory.Doi">doi.org/10.60592/bjwk-8n62</a>),
                @AreaHistoryMath.MonthName(dh.ArchiveFrom) to @AreaHistoryMath.MonthName(dh.ArchiveTo): the last month the NPI was listed as active.</p>
        }
        <p class="muted">Confirm in the official <a href="https://npiregistry.cms.hhs.gov/search?number=@Model.Npi">NPPES NPI Registry</a>.
            If the provider has a new NPI, <a href="/search">search by name</a>.</p>
    </section>
    return;
}
@{
    var p = Model.Provider;
    var cc = p.CareCompare;
    var compliance = p.Compliance;
    ViewData["Title"] = Model.DisplayName;
    var avatarTone = !Model.IsPerson ? "org" : p.Gender switch { "M" => "male", "F" => "female", _ => "neutral" };
    // State board data covers individual licensees; an organization's facility license isn't in it.
    var coveredLicenses = Model.IsPerson
        ? p.Taxonomies.Where(t => t.LicenseState is not null && StateLicenseSources.States.Contains(t.LicenseState)).ToList()
        : [];
}

@section Scripts {
    <script src="~/js/profile.js" asp-append-version="true" defer></script>
}

<div class="profile">
    @if (Model.BackLink is not null)
    {
        <nav aria-label="Breadcrumb" class="crumbs"><a href="@Model.BackLink">‹ Back to results</a></nav>
    }

    <section class="card profile-head" aria-labelledby="who">
        <div class="head-row">
            <svg class="avatar-lg @avatarTone" role="img" aria-label="@(Model.IsPerson ? "Avatar" : "Organization")" viewBox="0 0 104 104">
                <circle cx="52" cy="52" r="52" class="bg" />
                @if (Model.IsPerson)
                {
                    <circle cx="52" cy="41" r="18" class="fg" />
                    <path d="M20 92c5-20 17-30 32-30s27 10 32 30" class="fg" />
                }
                else
                {
                    <path d="M30 78V40l22-13 22 13v38M44 78V62h16v16M40 46h6M58 46h6M40 54h6M58 54h6" fill="none" class="stroke" stroke-width="4" stroke-linejoin="round" />
                }
            </svg>
            <div class="head-main">
                <h1 id="who">@Model.DisplayName@if (p.Credential is not null){<span class="credential">, @p.Credential</span>}</h1>
                <p class="summary">@Model.Summary</p>
                <ul class="pills" aria-label="Status">
                    @foreach (var s in Model.Status)
                    {
                        <li class="pill @s.Kind" title="@s.Title">@s.Text</li>
                    }
                </ul>
            </div>
            <div class="head-actions">
                <button type="button" class="secondary" data-copy="@p.Npi">Copy NPI</button>
                <a class="button" href="/provider/@p.Npi/raw.json" download>Download raw data</a>
                <a class="small" href="/provider/@p.Npi/raw.csv" download>Summary as CSV</a>
            </div>
        </div>
        <p class="head-facts">
            <span>NPI <span class="mono">@p.Npi</span></span>
            <span>@p.EntityTypeName</span>
            @if (p.Gender is "F" or "M"){<span>@(p.Gender == "F" ? "Female" : "Male")</span>}
            @if (cc?.GraduationYear is { } grad){<span>Graduated @grad</span>}
            @if (p.EnumerationDate is { } issued){<span>NPI issued @issued.ToString("MMMM yyyy", CultureInfo.InvariantCulture)</span>}
        </p>
        @if (Model.PrimaryLocation is { } primary && (primary.Phone is not null || ProviderModel.Directions(primary) is not null))
        {
            <p class="head-contact">
                @if (primary.Phone is not null){<a class="button" href="tel:@primary.Phone">Call @Format.Phone(primary.Phone)</a>}
                @if (ProviderModel.Directions(primary) is { } directions){<a class="button secondary" href="@directions">Directions</a>}
            </p>
        }
    </section>

    @if (p.Organization is { } org)
    {
        @* Step 3.9: the NPI's organization has a page with everything (its NPIs, facilities, groups); this page is the one NPI's record. *@
        <partial name="_OrganizationBanner" model="new OrganizationBanner(org, p.Npi, OrganizationBanner.NpiPage)" />
    }

    @if (compliance.Exclusions.Count > 0)
    {
        <div class="notice alert" role="note">
            <strong>On the HHS-OIG List of Excluded Individuals/Entities.</strong>
            Federal health care programs don't pay for items or services this provider furnishes, orders or prescribes.
            <ul>
                @foreach (var x in compliance.Exclusions)
                {
                    <li>
                        Excluded @x.ExclusionDate?.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)
                        under @x.Type@if (x.TypeDescription is not null){<span> (@x.TypeDescription)</span>}
                        @if (x.WaiverDate is not null){<span>; waiver @x.WaiverDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) in @x.WaiverState</span>}
                    </li>
                }
            </ul>
            <span class="muted">Matched by NPI. Confirm at <a href="https://exclusions.oig.hhs.gov/">exclusions.oig.hhs.gov</a>.</span>
        </div>
    }

    <div class="profile-row">
        @if (Model.Map is { } map)
        {
            <section class="card map-card" aria-labelledby="map-title">
                <h2 id="map-title" class="visually-hidden">Map of the practice locations</h2>
                <a class="static-map" href="@Model.MapLink">
                    <span class="visually-hidden">Open the practice locations on the map</span>
                    @foreach (var t in map.Tiles)
                    {
                        <img src="@t.Url" alt="" loading="lazy" decoding="async" referrerpolicy="strict-origin-when-cross-origin"
                             style="left:@(StaticMap.Css(t.LeftPercent))%;top:@(StaticMap.Css(t.TopPercent))%;width:@(StaticMap.Css(t.WidthPercent))%;height:@(StaticMap.Css(t.HeightPercent))%" />
                    }
                    @foreach (var pin in map.Pins.Reverse())
                    {
                        <span aria-hidden="true" class="pin@(pin.Approximate ? " approx" : "")" style="left:@(StaticMap.Css(pin.LeftPercent))%;top:@(StaticMap.Css(pin.TopPercent))%">@pin.Label</span>
                    }
                </a>
                <p class="map-foot"><a href="@Model.MapLink">Open the map</a><span>@Html.Raw(Model.Attribution)</span></p>
            </section>
        }
        <section class="card what-card" aria-labelledby="what">
            <span class="label">@Model.WhatLabel</span>
            <h2 id="what">@Model.SpecialtyName</h2>
            @if ((Model.Subcategory?.Description ?? Model.Category?.Description) is { } description)
            {
                <p>@description</p>
            }
            @if (Model.Placement is { } place && place.Category != SpecialtyCategories.FallbackCategory)
            {
                <p class="small"><a href="/search?category=@Uri.EscapeDataString(place.Category)&amp;subcategory=@Uri.EscapeDataString(place.Subcategory)@(Model.PrimaryLocation?.State is { } st ? "&state=" + st : "")">Other @((Model.Subcategory?.Title ?? Model.Category?.Title ?? "").ToLowerInvariant())@(Model.PrimaryLocation?.State is { } st2 ? " in " + (GeographyCatalog.StateName(st2) ?? st2) : "")</a></p>
            }
            @if (Model.PrimaryTaxonomy is { } tax)
            {
                <p class="src">Specialty from NPPES: @tax.Classification@if (tax.Specialization is not null){<text> – @tax.Specialization</text>} (NUCC code <span class="mono">@tax.Code</span>); description written for this site.</p>
            }
        </section>
    </div>

    <nav class="on-page" aria-label="On this page">
        @foreach (var (id, title) in Model.Sections)
        {
            <a class="chip" href="#@id">@title</a>
        }
    </nav>

    @if (Model.ClinicianList is { } clinicianList)
    {
        <partial name="_ClinicianList" model="clinicianList" />
        @if (Model.Groups.Count > 1)
        {
            <section class="card" aria-labelledby="groups-h">
                <h2 id="groups-h">Medicare groups (@Model.Groups.Count)</h2>
                <ul class="link-list">
                    @foreach (var g in Model.Groups)
                    {
                        <li><a href="/group/@g.PacId">@CityCatalog.TitleCase(g.Name)</a> <span class="muted">@g.Clinicians.ToString("N0", CultureInfo.InvariantCulture) clinicians · group ID <span class="mono">@g.PacId</span></span></li>
                    }
                </ul>
                <p class="src">Medicare Fee-For-Service Public Provider Enrollment: this NPI is enrolled as each of these groups.</p>
            </section>
        }
    }
    @if (!Model.IsPerson)
    {
        <partial name="_HealthSystemNote" model="new HealthSystemNote(HealthSystemNote.Npi, Model.Npi)" />
        <partial name="_AcoNote" model="new HealthSystemNote(HealthSystemNote.Npi, Model.Npi)" />
    }
    @if (!Model.IsPerson && p.Profile is { } responsible && (responsible.AuthorizedOfficial is not null || responsible.ParentOrganization is not null))
    {
        <section class="card" aria-labelledby="resp-h">
            <h2 id="resp-h">Who's responsible</h2>
            <dl class="facts">
                @if (responsible.AuthorizedOfficial is { } official)
                {
                    <dt>Authorized official</dt>
                    <dd>@CityCatalog.TitleCase(official.Name)@if (official.Credential is not null){<span>, @official.Credential</span>}@if (official.Title is not null){<span class="muted">, @CityCatalog.TitleCase(official.Title)</span>}</dd>
                    @if (official.Phone is not null){<dt>Phone</dt><dd><a href="tel:@official.Phone">@Format.Phone(official.Phone)</a></dd>}
                }
                <dt>Parent organization</dt>
                <dd>@(responsible.ParentOrganization is null ? "None listed" : CityCatalog.TitleCase(responsible.ParentOrganization) + (responsible.IsOrganizationSubpart == true ? " (this NPI is a subpart)" : ""))</dd>
            </dl>
            <p class="src">CMS NPPES.</p>
        </section>
    }

    <section class="card" id="where" aria-labelledby="where-h">
        <h2 id="where-h">Where @(Model.IsPerson ? "they practise" : "it is")</h2>
        <p class="lede">@(p.Locations.Count switch { 0 => "No practice location listed.", 1 => "One practice location.", var n => $"{n} practice locations." })</p>
        <div class="locations">
            @for (var i = 0; i < p.Locations.Count; i++)
            {
                var l = p.Locations[i];
                <div class="loc">
                    <span class="label">@(i + 1)@(l.IsPrimary ? " · Primary" : "")</span>
                    <strong>@(l.Address1 is null ? null : CityCatalog.TitleCase(l.Address1))</strong>
                    @if (l.Address2 is not null){<span>@CityCatalog.TitleCase(l.Address2)</span>}
                    <span>@ProviderModel.Place(l) @l.Zip@if (l.CountryCode is not null && l.CountryCode != "US"){<span class="muted"> (@l.CountryCode)</span>}</span>
                    @if (l.Phone is not null){<a href="tel:@l.Phone">@Format.Phone(l.Phone)</a>} else {<span class="muted">No phone listed</span>}
                    @if (AddressTypes.Label(l.BuildingType) is { } building){<span class="src" title="@l.BuildingBasis">@building building@(l.BuildingType == "residential" ? ", often a home office" : "")</span>}
                    @if (ProviderModel.Directions(l) is { } dir){<a class="small" href="@dir">Directions</a>}
                    @if (l.Approximate){<span class="src">On the map at the ZIP's centre; the street address couldn't be placed.</span>}
                </div>
            }
        </div>
        <p class="src">Practice addresses from NPPES. Building type from FEMA's <a href="https://gis-fema.hub.arcgis.com/pages/usa-structures">USA Structures</a> (building uses as of 2021); a residential building says nothing about the quality of care.</p>
    </section>

    <section class="card" id="specialties" aria-labelledby="spec-h">
        <h2 id="spec-h">Specialties &amp; licenses</h2>
        <partial name="_SpecialtiesLicenses" model="new ProviderPart(p, Model.IsPerson)" />
    </section>

    @if (Model.HasAffiliations)
    {
        <section class="card" id="works-with" aria-labelledby="ww-h">
            <h2 id="ww-h">@(Model.IsPerson ? "Works with" : "Medicare-certified facilities")</h2>
            @if (cc is not null && (cc.GroupPractices.Count > 0 || cc.Facilities.Count > 0))
            {
                <div class="affiliations">
                    @foreach (var g in cc.GroupPractices)
                    {
                        <div class="aff">
                            <span class="aff-icon group" aria-hidden="true"></span>
                            <span><a href="/group/@g.OrgPacId"><strong>@(g.Name is null ? "Group " + g.OrgPacId : CityCatalog.TitleCase(g.Name))</strong></a>
                                <span class="muted">Group practice@(g.Members is { } m ? $" · {m.ToString("N0", CultureInfo.InvariantCulture)} clinicians" : "")@(g.City is not null ? $" · {CityCatalog.TitleCase(g.City)}, {g.State}" : "")</span></span>
                        </div>
                    }
                    @foreach (var a in cc.Facilities)
                    {
                        <div class="aff">
                            <span class="aff-icon facility" aria-hidden="true"></span>
                            <span>
                                @if (a.Name is not null){<a href="/facility/@a.Ccn"><strong>@CityCatalog.TitleCase(a.Name)</strong></a>} else {<strong>CCN @a.Ccn</strong>}
                                <span class="muted">@a.FacilityType@(a.OverallRating is { } r ? $" · {r} of 5 CMS stars" : "")@(a.City is not null ? $" · {CityCatalog.TitleCase(a.City)}, {a.State}" : "")</span>
                            </span>
                        </div>
                    }
                </div>
                <p class="src">Group practices and facility affiliations from Medicare Care Compare.</p>
            }
            @if (Model.BillsThrough.Count > 0)
            {
                <h3>Bills Medicare through</h3>
                <ul class="link-list">
                    @foreach (var g in Model.BillsThrough)
                    {
                        <li><a href="/group/@g.PacId">@CityCatalog.TitleCase(g.Name)</a> <span class="muted">group ID <span class="mono">@g.PacId</span></span></li>
                    }
                </ul>
                <p class="src">Medicare enrollment: groups this clinician reassigns Medicare payments to.</p>
            }
            @foreach (var fac in p.Facilities)
            {
                <dl class="facts">
                    <dt>@(fac.Kind switch { "hospital" => "Hospital", "nursing_home" => "Nursing home", "home_health" => "Home health agency", "hospice" => "Hospice", _ => FacilityTypes.Get(fac.Kind).Singular })</dt>
                    <dd><a href="/facility/@fac.Ccn"><strong>@CityCatalog.TitleCase(fac.Name)</strong></a> <span class="muted">CCN @fac.Ccn · @(fac.City is null ? null : CityCatalog.TitleCase(fac.City)), @fac.State</span></dd>
                    @if (fac.Type is not null){<dt>Type</dt><dd>@fac.Type</dd>}
                    @if (fac.Ownership is not null){<dt>Ownership</dt><dd>@fac.Ownership</dd>}
                    @if (fac.EmergencyServices is { } er){<dt>Emergency services</dt><dd>@(er ? "Yes" : "No")</dd>}
                    @if (fac.CertifiedBeds is not null){<dt>Certified beds</dt><dd>@fac.CertifiedBeds</dd>}
                    @if (fac.Kind is "hospital" or "nursing_home"){<dt>Overall rating</dt><dd>@Stars(fac.OverallRating)</dd>}
                    @if (fac.Kind == "home_health"){<dt>Quality of patient care</dt><dd>@HalfStars(fac.QualityOfCareRating)</dd>}
                    @if (fac.Kind == "hospital"){<dt>Patient survey (HCAHPS)</dt><dd>@Stars(fac.PatientSurveyRating)</dd>}
                    @if (fac.Kind == "hospice"){<dt>Family caregiver survey</dt><dd>@Stars(fac.PatientSurveyRating)</dd>}
                    @if (fac.Kind == FacilityTypes.Dialysis){<dt>Five-star rating</dt><dd>@Stars(fac.OverallRating)</dd><dt>Patient survey (ICH CAHPS)</dt><dd>@Stars(fac.PatientSurveyRating)</dd>}
                    @if (fac.Outcomes is { } o)
                    {
                        <dt>Deaths</dt><dd>@Outcome(o.Mortality)</dd>
                        <dt>Safety (infections, complications)</dt><dd>@Outcome(o.Safety)</dd>
                        <dt>Readmissions</dt><dd>@Outcome(o.Readmissions)</dd>
                    }
                    @if (fac.Kind == "nursing_home")
                    {
                        <dt>Health inspections</dt><dd>@Stars(fac.InspectionRating)</dd>
                        <dt>Staffing</dt><dd>@Stars(fac.StaffingRating)</dd>
                        <dt>Quality measures</dt><dd>@Stars(fac.QualityRating)</dd>
                    }
                    @if (fac.AffiliatedClinicians > 0){<dt>Affiliated clinicians</dt><dd>@fac.AffiliatedClinicians.ToString("N0", CultureInfo.InvariantCulture)</dd>}
                </dl>
            }
            @if (p.Facilities.Count > 0)
            {
                <p class="src">Ratings from Medicare Care Compare.@if (p.Facilities.Any(f => f.Outcomes is not null)){<text> Deaths, safety and readmissions count the hospital's measures that CMS rates better or worse than the national rate; the rest are no different.</text>}</p>
            }
        </section>
    }

    <section class="card" id="standing" aria-labelledby="st-h">
        <h2 id="st-h">Standing</h2>
        <ul class="checks">
            @if (compliance.Exclusions.Count > 0)
            {
                <li class="bad"><span aria-hidden="true">✕</span>On the federal exclusion list (HHS-OIG); see the notice above</li>
            }
            else
            {
                <li class="good"><span aria-hidden="true">✓</span>Not on the federal exclusion list (HHS-OIG)</li>
            }
            @if (compliance.OptOut is { } optOut)
            {
                <li class="@(optOut.Active ? "warn" : "info")"><span aria-hidden="true">@(optOut.Active ? "!" : "i")</span>@(optOut.Active ? "Opted out of Medicare" : "A Medicare opt-out ended")
                    (@optOut.EffectiveDate?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) to @optOut.EndDate?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)): Medicare doesn't pay for their services during an opt-out</li>
            }
            else
            {
                <li class="good"><span aria-hidden="true">✓</span>Hasn't opted out of Medicare</li>
            }
            @if (compliance.OrderReferring is { } orders)
            {
                var programs = new[] { (orders.PartB, "Part B"), (orders.DurableMedicalEquipment, "equipment (DME)"), (orders.HomeHealth, "home health"),
                                       (orders.PowerMobilityDevices, "power mobility devices"), (orders.Hospice, "hospice") }
                    .Where(x => x.Item1).Select(x => x.Item2).ToList();
                <li class="info"><span aria-hidden="true">i</span>@(programs.Count > 0 ? "Can order and refer for Medicare: " + string.Join(", ", programs) : "On Medicare's order and refer list, for no programs")</li>
            }
            else if (Model.IsPerson)
            {
                <li class="info"><span aria-hidden="true">i</span>Not on Medicare's list of providers who may order and refer</li>
            }
            @foreach (var m in compliance.Medicaid)
            {
                <li class="good"><span aria-hidden="true">✓</span>Enrolled in @(m.State == "NY" ? "New York Medicaid" : m.State == "CA" ? "Medi-Cal (California Medicaid)" : m.State + " Medicaid")@if (m.EnrolledSince is { } since){<text> since @since.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</text>}@if (m.ProviderType is { Length: > 0 } kind){<span class="muted"> · @(kind == kind.ToUpperInvariant() ? CultureInfo.InvariantCulture.TextInfo.ToTitleCase(kind.ToLowerInvariant()) : kind)</span>}</li>
            }
            @if (Model.HasBoardAction)
            {
                <li class="warn"><span aria-hidden="true">!</span>A state board action or discipline is on record; see Specialties &amp; licenses</li>
            }
            else if (p.StateLicenses.Count > 0 || coveredLicenses.Count > 0)
            {
                <li class="good"><span aria-hidden="true">✓</span>No board actions on record in @string.Join(", ", p.StateLicenses.Select(l => l.State).Concat(coveredLicenses.Select(t => t.LicenseState!)).Distinct())</li>
            }
        </ul>
        <p class="src">HHS-OIG exclusion list (LEIE), CMS opt-out and order and refer lists, state licensing boards, the New York and California Medicaid enrolled-provider lists. Matched by NPI (licenses by state, number and name).</p>
    </section>

    @if (p.Quality is { } quality)
    {
        <section class="card" id="record-quality" aria-labelledby="rq-h">
            <h2 id="rq-h">Record quality: @(quality.Label switch { QualityLabel.Stale => "looks stale", QualityLabel.Check => "needs a check", _ => "looks current" })</h2>
            <p class="muted">@(quality.Label switch
            {
                QualityLabel.Stale => "This record is old and nothing in the public data shows the provider still practises here. Confirm before relying on it.",
                QualityLabel.Check => "Something in this record conflicts with other sources or is missing. Confirm the details below before relying on it.",
                _ => "Nothing we checked suggests the record is out of date.",
            })</p>
            <ul class="checks">
                @foreach (var note in Model.QualityNotes)
                {
                    <li class="@note.Kind"><span aria-hidden="true">@(note.Kind switch { "good" => "✓", "bad" => "✕", "warn" => "!", _ => "i" })</span>@note.Text@if (note.Href is not null){<a href="@note.Href" class="mono">@note.LinkText</a>}</li>
                }
            </ul>
            <p class="src">Our own check, rebuilt with each weekly load: the NPPES record's age and address, compared with Medicare (billing, enrollment,
                Care Compare), state Medicaid lists (NY, CA), Open Payments, state licensing boards and building data. A label is a prompt to verify, not a finding.</p>
        </section>
    }

    @if (Model.HasMedicare)
    {
        <section class="card" id="medicare" aria-labelledby="med-h">
            <h2 id="med-h">Medicare activity</h2>
            <partial name="_MedicareActivity" model="new ProviderPart(p, Model.IsPerson)" />
        </section>
    }

    @if (p.MipsScores.Count > 0)
    {
        <section class="card" id="quality" aria-labelledby="q-h">
            <h2 id="q-h">Medicare quality score (MIPS @p.MipsScores[0].Year)</h2>
            <p class="lede">Final score <strong>@Score(p.MipsScores[0].FinalScore)</strong> of 100@(p.MipsScores.Count > 1 ? $", the best of {p.MipsScores.Count} ways this clinician was scored" : "").</p>
            <div class="table-wrap">
                <table>
                    <caption class="visually-hidden">MIPS scores</caption>
                    <thead><tr><th scope="col">Scored as</th><th scope="col">Final score</th><th scope="col">Quality</th><th scope="col">Promoting interoperability</th><th scope="col">Improvement activities</th><th scope="col">Cost</th></tr></thead>
                    <tbody>
                        @foreach (var m in p.MipsScores)
                        {
                            <tr>
                                <td>@(m.Source switch { "individual" => "Individual", "group" => "Group", "apm" => "APM entity", "subgroup" => "Subgroup", "virtual group" => "Virtual group", _ => m.Source })@if (m.Organization is not null){<br /><span class="muted">@m.Organization</span>}</td>
                                <td><strong>@Score(m.FinalScore)</strong></td><td>@Score(m.Quality)</td><td>@Score(m.PromotingInteroperability)</td><td>@Score(m.ImprovementActivities)</td><td>@Score(m.Cost)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="src">Merit-based Incentive Payment System (MIPS) scores, 0–100, from Medicare Care Compare. MIPS adjusts what Medicare pays clinicians by their quality, cost and use of technology; a clinician may be scored individually, with a group or with an alternative payment model (APM) entity. “—” means the category wasn't scored.</p>
        </section>
    }

    @if (p.IndustryPayments is not null || p.PaymentHistory is not null)
    {
        <section class="card" id="payments" aria-labelledby="pay-h">
            <h2 id="pay-h">Industry payments</h2>
            @if (p.IndustryPayments is { } pay)
            {
                <p class="lede">
                    <strong>@Money(pay.TotalAmount)</strong> in @pay.Records.ToString("N0", CultureInfo.InvariantCulture) general payment@(pay.Records == 1 ? "" : "s") in @pay.Year
                    from @pay.Payers.ToString("N0", CultureInfo.InvariantCulture) @(pay.Payers == 1 ? "company" : "companies") (drug and device makers, as reported to CMS Open Payments).
                </p>
                <div class="table-wrap">
                    <table>
                        <caption class="visually-hidden">Industry payments by kind</caption>
                        <thead><tr><th scope="col">Kind of payment</th><th scope="col">Amount</th><th scope="col">Payments</th></tr></thead>
                        <tbody>
                            @foreach (var k in pay.ByNature)
                            {
                                <tr><td>@k.Nature</td><td>@Money(k.Amount)</td><td>@k.Records.ToString("N0", CultureInfo.InvariantCulture)</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (pay.TopPayers.Count > 0)
                {
                    <p>Top payers:
                        @for (var i = 0; i < pay.TopPayers.Count; i++)
                        {
                            var t = pay.TopPayers[i];
                            if (i > 0) { <text>; </text> }
                            if (t.CompanyId is not null) { <a href="/company/@Uri.EscapeDataString(t.CompanyId)">@t.Name</a> } else { <text>@t.Name</text> }
                            <text> (@Money(t.Amount))</text>
                        }
                    </p>
                }
                @if (pay.TopProducts.Count > 0)
                {
                    <p>Products named most in these payments:
                        @for (var i = 0; i < pay.TopProducts.Count; i++)
                        {
                            var pr = pay.TopProducts[i];
                            if (i > 0) { <text>; </text> }
                            <a href="/product/@pr.Slug">@pr.Name</a>
                            <text> (@Money(pr.Amount)@(pr.MedicareClaims is { } mc ? $"; {mc.ToString("N0", CultureInfo.InvariantCulture)} Medicare Part D claims of it" : ""))</text>
                        }
                    </p>
                }
            }

            @if (p.PaymentHistory is { } history)
            {
                var years = history.Years;
                var showResearch = years.Any(y => y.Research > 0) || history.TopCompanies.Any(c => c.Research > 0);
                var showAssociated = years.Any(y => y.AssociatedResearch > 0) || history.TopCompanies.Any(c => c.AssociatedResearch > 0);
                var showOwnership = years.Any(y => y.OwnershipInvested > 0 || y.OwnershipValue > 0) || history.TopCompanies.Any(c => c.Ownership > 0);
                <h3>By year</h3>
                @if (years.Count > 0)
                {
                    <p>
                        <strong>@Money(years.Sum(y => y.General + y.Research))</strong> paid to this provider in @years.Count program year@(years.Count == 1 ? "" : "s")
                        (@(years.Min(y => y.Year))–@(years.Max(y => y.Year)))@(showAssociated ? $", plus {Money(years.Sum(y => y.AssociatedResearch))} of research funding where they were a principal investigator" : "").
                    </p>
                    <div class="table-wrap">
                        <table>
                            <caption class="visually-hidden">Industry payments by program year</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Year</th><th scope="col">General payments</th>
                                    @if (showResearch) { <th scope="col">Research</th> }
                                    @if (showAssociated) { <th scope="col" title="Research funding paid to an institution where this provider was a principal investigator">Research as investigator</th> }
                                    @if (showOwnership) { <th scope="col">Ownership invested</th><th scope="col">Ownership value</th> }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var y in years)
                                {
                                    <tr>
                                        <td>@y.Year</td>
                                        <td>@Amount(y.General, y.GeneralRecords)</td>
                                        @if (showResearch) { <td>@Amount(y.Research, y.ResearchRecords)</td> }
                                        @if (showAssociated) { <td>@Amount(y.AssociatedResearch, y.AssociatedResearchRecords)</td> }
                                        @if (showOwnership) { <td>@Amount(y.OwnershipInvested, null)</td><td>@Amount(y.OwnershipValue, null)</td> }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                @if (history.TopCompanies.Count > 0)
                {
                    <h3>Top companies, all years</h3>
                    <div class="table-wrap">
                        <table>
                            <caption class="visually-hidden">The companies that paid this provider the most over all program years</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Company</th><th scope="col">General</th>
                                    @if (showResearch) { <th scope="col">Research</th> }
                                    @if (showAssociated) { <th scope="col">Research as investigator</th> }
                                    @if (showOwnership) { <th scope="col">Ownership</th> }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in history.TopCompanies)
                                {
                                    <tr>
                                        <td>@if (c.CompanyId is not null){<a href="/company/@Uri.EscapeDataString(c.CompanyId)">@c.Name</a>}else{@c.Name}</td><td>@Amount(c.General, null)</td>
                                        @if (showResearch) { <td>@Amount(c.Research, null)</td> }
                                        @if (showAssociated) { <td>@Amount(c.AssociatedResearch, null)</td> }
                                        @if (showOwnership) { <td>@Amount(c.Ownership, null)</td> }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            <p class="src">CMS Open Payments. A payment is not evidence of wrongdoing. Research as investigator is funding paid to an institution for research this provider led; ownership is the value of an ownership or investment interest, not a payment. Verify at <a href="https://openpaymentsdata.cms.gov/">openpaymentsdata.cms.gov</a>.</p>
        </section>
    }

    @if (p.Changes.Count > 0)
    {
        <section class="card" id="changes" aria-labelledby="ch-h">
            <h2 id="ch-h">Changes</h2>
            <div class="table-wrap">
                <table>
                    <caption class="visually-hidden">Recorded changes</caption>
                    <thead><tr><th scope="col">Recorded</th><th scope="col">What changed</th><th scope="col">Before</th><th scope="col">After</th></tr></thead>
                    <tbody>
                        @foreach (var c in p.Changes)
                        {
                            <tr>
                                <td>@c.RecordedOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                                <td>@Npi.Core.Search.ChangeTypes.Label(c.Type)</td>
                                <td>@(c.OldValue ?? "(none)")</td>
                                <td>@(c.NewValue ?? "(none)")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="src">Tracked since October 2026: NPPES changes from the weekly files; state licenses and board actions, OIG exclusions and Medicare opt-outs from each reload of those lists (since October 14, 2026).</p>
        </section>
    }

    @if (p.History is { Versions.Count: > 0 } past)
    {
        <section class="card" id="history" aria-labelledby="hist-h">
            <h2 id="hist-h">Over the years</h2>
            <partial name="_OverTheYears" model="past" />
        </section>
    }

    <section class="card" id="record" aria-labelledby="rec-h">
        <h2 id="rec-h">Registration &amp; identifiers</h2>
        <partial name="_RegistrationIdentifiers" model="new ProviderPart(p, Model.IsPerson)" />
        <p class="src">CMS NPPES, updated @Format.Ago(p.LastUpdateDate). Verify with the official <a href="https://npiregistry.cms.hhs.gov/provider-view/@p.Npi">NPPES NPI Registry</a>.
            <a href="/provider/@p.Npi/raw.json" download>Download raw data</a> (everything on this page, as JSON).</p>
    </section>
</div>

@functions {
    private static string Count(double? value) => value is null ? "Suppressed" : value.Value.ToString("N0", CultureInfo.InvariantCulture);

    private static string Money(double? value) => value is null ? "Suppressed" : value.Value.ToString("$#,##0", CultureInfo.InvariantCulture);

    // An Open Payments amount: "—" for none, else the dollars and, when given, how many payments.
    private static string Amount(double value, int? records) => value <= 0 ? "—"
        : records is > 0 ? $"{Money(value)} ({records.Value.ToString("N0", CultureInfo.InvariantCulture)})" : Money(value);

    private static string Score(double? value) => value is null ? "—" : value.Value.ToString("0.#", CultureInfo.InvariantCulture);

    // Half stars, e.g. 3.5 → ★★★½☆ (3.5/5).
    private static string HalfStars(double? rating) => rating is >= 1 and <= 5
        ? new string('★', (int)rating.Value) + (rating.Value % 1 >= 0.5 ? "½" : "") + new string('☆', 5 - (int)Math.Ceiling(rating.Value))
          + $" ({rating.Value.ToString("0.#", CultureInfo.InvariantCulture)}/5)"
        : "Not rated";

    // "2 better, 1 worse of 11" (the rest are no different from the national rate).
    private static string Outcome(OutcomeCounts c) => c.Measures is not > 0 ? "Not available"
        : $"{c.Better ?? 0} better, {c.Worse ?? 0} worse than national, of {c.Measures}";

    private static string Stars(int? rating) => rating is >= 1 and <= 5 ? new string('★', rating.Value) + new string('☆', 5 - rating.Value) + $" ({rating}/5)" : "Not rated";
}
