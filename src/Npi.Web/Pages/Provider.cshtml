@page "/provider/{npi}"
@using System.Globalization
@model ProviderModel
@{
    var p = Model.Provider;
    ViewData["Title"] = p.Name;
}

<p><a href="javascript:history.back()">‹ Back to results</a></p>

<h1>@p.Name@if (p.Credential is not null){<span class="muted">, @p.Credential</span>}</h1>

<dl class="facts">
    <dt>NPI</dt><dd>@p.Npi</dd>
    <dt>Type</dt><dd>@p.EntityTypeName</dd>
    @if (p.Gender is not null)
    {
        <dt>Gender</dt><dd>@(p.Gender == "F" ? "Female" : p.Gender == "M" ? "Male" : p.Gender)</dd>
    }
    <dt>Enumerated</dt><dd>@p.EnumerationDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</dd>
    <dt>Last updated</dt><dd>@p.LastUpdateDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</dd>
</dl>

@{ var compliance = p.Compliance; }
@if (compliance.Exclusions.Count > 0)
{
    <div class="notice alert" role="note">
        <strong>On the HHS-OIG List of Excluded Individuals/Entities.</strong>
        Federal health care programs don't pay for items or services this provider furnishes, orders or prescribes.
        <ul>
            @foreach (var x in compliance.Exclusions)
            {
                <li>
                    Excluded @x.ExclusionDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                    under @x.Type@if (x.TypeDescription is not null){<span> (@x.TypeDescription)</span>}
                    @if (x.WaiverDate is not null){<span>; waiver @x.WaiverDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) in @x.WaiverState</span>}
                </li>
            }
        </ul>
        <span class="muted">Matched by NPI. Confirm at <a href="https://exclusions.oig.hhs.gov/">exclusions.oig.hhs.gov</a>.</span>
    </div>
}

@if (compliance.OptOut is not null || compliance.OrderReferring is not null)
{
    <h2>Medicare</h2>
    <dl class="facts">
        @if (compliance.OptOut is { } optOut)
        {
            <dt>Opt-out</dt>
            <dd>
                @(optOut.Active ? "Opted out of Medicare" : "Opt-out ended")
                (@optOut.EffectiveDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) to @optOut.EndDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))
                @if (optOut.Specialty is not null){<span class="muted"> · @optOut.Specialty</span>}
            </dd>
        }
        @if (compliance.OrderReferring is { } orders)
        {
            var programs = new[] { (orders.PartB, "Part B"), (orders.DurableMedicalEquipment, "DME"), (orders.HomeHealth, "home health"),
                                   (orders.PowerMobilityDevices, "power mobility devices"), (orders.Hospice, "hospice") }
                .Where(x => x.Item1).Select(x => x.Item2).ToList();
            <dt>May order/refer</dt>
            <dd>@(programs.Count > 0 ? string.Join(", ", programs) : "No programs")</dd>
        }
    </dl>
}

@if (p.Facilities.Count > 0)
{
    <h2>Medicare-certified facilities</h2>
    @foreach (var fac in p.Facilities)
    {
        <dl class="facts">
            <dt>@(fac.Kind switch { "hospital" => "Hospital", "nursing_home" => "Nursing home", "home_health" => "Home health agency", "hospice" => "Hospice", _ => fac.Kind })</dt>
            <dd><strong>@fac.Name</strong> <span class="muted">CCN @fac.Ccn · @fac.City, @fac.State</span></dd>
            @if (fac.Type is not null){<dt>Type</dt><dd>@fac.Type</dd>}
            @if (fac.Ownership is not null){<dt>Ownership</dt><dd>@fac.Ownership</dd>}
            @if (fac.EmergencyServices is { } er){<dt>Emergency services</dt><dd>@(er ? "Yes" : "No")</dd>}
            @if (fac.CertifiedBeds is not null){<dt>Certified beds</dt><dd>@fac.CertifiedBeds</dd>}
            @if (fac.Kind is "hospital" or "nursing_home"){<dt>Overall rating</dt><dd>@Stars(fac.OverallRating)</dd>}
            @if (fac.Kind == "home_health"){<dt>Quality of patient care</dt><dd>@HalfStars(fac.QualityOfCareRating)</dd>}
            @if (fac.Kind == "hospital"){<dt>Patient survey (HCAHPS)</dt><dd>@Stars(fac.PatientSurveyRating)</dd>}
            @if (fac.Kind == "hospice"){<dt>Family caregiver survey</dt><dd>@Stars(fac.PatientSurveyRating)</dd>}
            @if (fac.Outcomes is { } o)
            {
                <dt>Deaths</dt><dd>@Outcome(o.Mortality)</dd>
                <dt>Safety (infections, complications)</dt><dd>@Outcome(o.Safety)</dd>
                <dt>Readmissions</dt><dd>@Outcome(o.Readmissions)</dd>
            }
            @if (fac.Kind == "nursing_home")
            {
                <dt>Health inspections</dt><dd>@Stars(fac.InspectionRating)</dd>
                <dt>Staffing</dt><dd>@Stars(fac.StaffingRating)</dd>
                <dt>Quality measures</dt><dd>@Stars(fac.QualityRating)</dd>
            }
            @if (fac.AffiliatedClinicians > 0){<dt>Affiliated clinicians</dt><dd>@fac.AffiliatedClinicians.ToString("N0", CultureInfo.InvariantCulture)</dd>}
        </dl>
    }
    <p class="muted">Ratings from Medicare Care Compare. Deaths, safety and readmissions count the hospital's measures that CMS rates better or worse than the national rate; the rest are no different.</p>
}

@* Stage 5.5 item 14: MIPS, Medicare's clinician quality program (Care Compare). *@
@if (p.MipsScores.Count > 0)
{
    <h2>Medicare quality score (MIPS @p.MipsScores[0].Year)</h2>
    <div class="table-wrap">
        <table>
            <caption class="visually-hidden">MIPS scores</caption>
            <thead><tr><th scope="col">Scored as</th><th scope="col">Final score</th><th scope="col">Quality</th><th scope="col">Promoting interoperability</th><th scope="col">Improvement activities</th><th scope="col">Cost</th></tr></thead>
            <tbody>
                @foreach (var m in p.MipsScores)
                {
                    <tr>
                        <td>@(m.Source switch { "individual" => "Individual", "group" => "Group", "apm" => "APM entity", "subgroup" => "Subgroup", "virtual group" => "Virtual group", _ => m.Source })@if (m.Organization is not null){<br /><span class="muted">@m.Organization</span>}</td>
                        <td><strong>@Score(m.FinalScore)</strong></td><td>@Score(m.Quality)</td><td>@Score(m.PromotingInteroperability)</td><td>@Score(m.ImprovementActivities)</td><td>@Score(m.Cost)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="muted">Merit-based Incentive Payment System scores, 0–100, from Medicare Care Compare; a clinician may be scored individually, with a group or with an alternative payment model (APM) entity. “—” means the category wasn't scored.</p>
}

@if (p.CareCompare is { } cc)
{
    <h2>Medicare Care Compare</h2>
    <dl class="facts">
        @if (cc.MedicalSchool is not null || cc.GraduationYear is not null)
        {
            <dt>Education</dt>
            <dd>@(cc.MedicalSchool == "OTHER" ? "Other school" : cc.MedicalSchool)@if (cc.GraduationYear is { } year){<span>, graduated @year (@(DateTime.Today.Year - year) years ago)</span>}</dd>
        }
        @if (cc.PrimarySpecialty is not null)
        {
            <dt>Medicare specialty</dt><dd>@cc.PrimarySpecialty@if (cc.SecondarySpecialties is not null){<span class="muted"> · also @cc.SecondarySpecialties</span>}</dd>
        }
        <dt>Accepts Medicare assignment</dt><dd>@(cc.AcceptsMedicareAssignment ? "Yes" : "Not always")</dd>
        <dt>Telehealth</dt><dd>@(cc.OffersTelehealth ? "Offered" : "Not listed")</dd>
    </dl>
    @if (cc.GroupPractices.Count > 0)
    {
        <h3>Group practices</h3>
        <ul>
            @foreach (var g in cc.GroupPractices)
            {
                <li>@(g.Name ?? "Group " + g.OrgPacId)@if (g.Members is not null){<span class="muted"> · @g.Members members</span>}@if (g.City is not null){<span class="muted"> · @g.City, @g.State</span>}</li>
            }
        </ul>
    }
    @if (cc.Facilities.Count > 0)
    {
        <h3>Facility affiliations</h3>
        <ul>
            @foreach (var a in cc.Facilities)
            {
                <li>
                    @a.FacilityType:
                    @if (a.Npi is not null){<a href="/provider/@a.Npi">@(a.Name ?? "CCN " + a.Ccn)</a>} else {<span>@(a.Name ?? "CCN " + a.Ccn)</span>}
                    @if (a.City is not null){<span class="muted"> · @a.City, @a.State</span>}
                    @if (a.OverallRating is not null){<span class="muted"> · @Stars(a.OverallRating)</span>}
                </li>
            }
        </ul>
    }
}

@if (p.MedicareServices is { } mu)
{
    <h2>Medicare services (@mu.Year)</h2>
    <dl class="facts">
        @if (mu.ProviderType is not null){<dt>Medicare provider type</dt><dd>@mu.ProviderType@if (mu.Participating == false){<span class="muted"> · non-participating</span>}</dd>}
        <dt>Patients</dt><dd>@Count(mu.Beneficiaries)</dd>
        <dt>Services</dt><dd>@Count(mu.Services)@if (mu.DistinctServices is not null){<span class="muted"> · @mu.DistinctServices distinct procedure codes</span>}</dd>
        <dt>Medicare paid</dt><dd>@Money(mu.PaymentAmount)@if (mu.AllowedAmount is not null){<span class="muted"> of @Money(mu.AllowedAmount) allowed</span>}</dd>
        @if (mu.AverageRiskScore is not null){<dt>Patients' average risk score</dt><dd>@mu.AverageRiskScore.Value.ToString("0.00", CultureInfo.InvariantCulture) <span class="muted">(1.00 = average Medicare patient)</span></dd>}
    </dl>
    @if (mu.TopServices.Count > 0)
    {
        <div class="table-wrap">
            <table>
                <caption class="visually-hidden">Most frequent Medicare services</caption>
                <thead><tr><th scope="col">Code</th><th scope="col">Service</th><th scope="col">Setting</th><th scope="col">Patients</th><th scope="col">Services</th><th scope="col">Avg. Medicare payment</th></tr></thead>
                <tbody>
                    @foreach (var s in mu.TopServices)
                    {
                        <tr><td>@s.Hcpcs</td><td>@s.Description</td><td>@s.PlaceOfService</td><td>@Count(s.Beneficiaries)</td><td>@Count(s.Services)</td><td>@Money(s.AveragePayment)</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@if (p.MedicarePrescribing is { } rx)
{
    <h2>Medicare Part D prescribing (@rx.Year)</h2>
    <dl class="facts">
        <dt>Prescriptions (claims)</dt><dd>@Count(rx.Claims)@if (rx.Beneficiaries is not null){<span class="muted"> for @Count(rx.Beneficiaries) patients</span>}</dd>
        <dt>Drug cost</dt><dd>@Money(rx.DrugCost)</dd>
        @if (rx.BrandClaims is not null && rx.Claims is > 0){<dt>Brand-name share</dt><dd>@((100.0 * rx.BrandClaims.Value / rx.Claims.Value).ToString("0", CultureInfo.InvariantCulture))% of claims</dd>}
        @if (rx.OpioidRate is not null){<dt>Opioid prescribing rate</dt><dd>@rx.OpioidRate.Value.ToString("0.0", CultureInfo.InvariantCulture)% of claims</dd>}
        @if (rx.AntibioticClaims is not null){<dt>Antibiotic claims</dt><dd>@Count(rx.AntibioticClaims)</dd>}
    </dl>
}

@if (p.MedicareServices is not null || p.MedicarePrescribing is not null)
{
    <p class="muted">From CMS Medicare Physician &amp; Other Practitioners and Part D Prescribers data (traditional Medicare only; counts under 11 are suppressed by CMS).</p>
}

@if (p.IndustryPayments is { } pay)
{
    <h2>Industry payments (@pay.Year)</h2>
    <p>
        <strong>@Money(pay.TotalAmount)</strong> in @pay.Records.ToString("N0", CultureInfo.InvariantCulture) general payment@(pay.Records == 1 ? "" : "s")
        from @pay.Payers.ToString("N0", CultureInfo.InvariantCulture) @(pay.Payers == 1 ? "company" : "companies") (drug and device makers, as reported to CMS Open Payments).
    </p>
    <div class="table-wrap">
        <table>
            <caption class="visually-hidden">Industry payments by kind</caption>
            <thead><tr><th scope="col">Kind of payment</th><th scope="col">Amount</th><th scope="col">Payments</th></tr></thead>
            <tbody>
                @foreach (var k in pay.ByNature)
                {
                    <tr><td>@k.Nature</td><td>@Money(k.Amount)</td><td>@k.Records.ToString("N0", CultureInfo.InvariantCulture)</td></tr>
                }
            </tbody>
        </table>
    </div>
    @if (pay.TopPayers.Count > 0)
    {
        <p>Top payers: @string.Join("; ", pay.TopPayers.Select(t => $"{t.Name} ({Money(t.Amount)})"))</p>
    }
    <p class="muted">General payments only; research payments and ownership interests are under “Industry payments by year”. Verify at <a href="https://openpaymentsdata.cms.gov/">openpaymentsdata.cms.gov</a>.</p>
}

@* Stage 5.5 item 13: every published program year, with research and ownership; columns that are all zero are left out. *@
@if (p.PaymentHistory is { } history)
{
    var years = history.Years;
    var showResearch = years.Any(y => y.Research > 0) || history.TopCompanies.Any(c => c.Research > 0);
    var showAssociated = years.Any(y => y.AssociatedResearch > 0) || history.TopCompanies.Any(c => c.AssociatedResearch > 0);
    var showOwnership = years.Any(y => y.OwnershipInvested > 0 || y.OwnershipValue > 0) || history.TopCompanies.Any(c => c.Ownership > 0);
    <h2>Industry payments by year</h2>
    @if (years.Count > 0)
    {
        <p>
            <strong>@Money(years.Sum(y => y.General + y.Research))</strong> paid to this provider in @years.Count program year@(years.Count == 1 ? "" : "s")
            (@(years.Min(y => y.Year))–@(years.Max(y => y.Year)))@(showAssociated ? $", plus {Money(years.Sum(y => y.AssociatedResearch))} of research funding where they were a principal investigator" : "").
        </p>
        <div class="table-wrap">
            <table>
                <caption class="visually-hidden">Industry payments by program year</caption>
                <thead>
                    <tr>
                        <th scope="col">Year</th><th scope="col">General payments</th>
                        @if (showResearch) { <th scope="col">Research</th> }
                        @if (showAssociated) { <th scope="col" title="Research funding paid to an institution where this provider was a principal investigator">Research as investigator</th> }
                        @if (showOwnership) { <th scope="col">Ownership invested</th><th scope="col">Ownership value</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var y in years)
                    {
                        <tr>
                            <td>@y.Year</td>
                            <td>@Amount(y.General, y.GeneralRecords)</td>
                            @if (showResearch) { <td>@Amount(y.Research, y.ResearchRecords)</td> }
                            @if (showAssociated) { <td>@Amount(y.AssociatedResearch, y.AssociatedResearchRecords)</td> }
                            @if (showOwnership) { <td>@Amount(y.OwnershipInvested, null)</td><td>@Amount(y.OwnershipValue, null)</td> }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (history.TopCompanies.Count > 0)
    {
        <h3>Top companies, all years</h3>
        <p class="muted">The five companies with the largest amounts of any kind, over every published year.</p>
        <div class="table-wrap">
            <table>
                <caption class="visually-hidden">The companies that paid this provider the most over all program years</caption>
                <thead>
                    <tr>
                        <th scope="col">Company</th><th scope="col">General</th>
                        @if (showResearch) { <th scope="col">Research</th> }
                        @if (showAssociated) { <th scope="col">Research as investigator</th> }
                        @if (showOwnership) { <th scope="col">Ownership</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in history.TopCompanies)
                    {
                        <tr>
                            <td>@c.Name</td><td>@Amount(c.General, null)</td>
                            @if (showResearch) { <td>@Amount(c.Research, null)</td> }
                            @if (showAssociated) { <td>@Amount(c.AssociatedResearch, null)</td> }
                            @if (showOwnership) { <td>@Amount(c.Ownership, null)</td> }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <p class="muted">CMS Open Payments, every published program year. Research as investigator is funding paid to a hospital or institution for research this provider led. Ownership is the value of an ownership or investment interest (as reported), not a payment. Verify at <a href="https://openpaymentsdata.cms.gov/">openpaymentsdata.cms.gov</a>.</p>
}

<h2>Specialties</h2>
<div class="table-wrap">
    <table>
        <thead><tr><th scope="col">Taxonomy</th><th scope="col">Classification</th><th scope="col">Specialization</th><th scope="col">Primary</th><th scope="col">License</th><th scope="col">License state</th></tr></thead>
        <tbody>
            @foreach (var t in p.Taxonomies)
            {
                <tr>
                    <td><a href="/?taxonomy=@t.Code">@t.Code</a></td>
                    <td>@t.Classification</td>
                    <td>@t.Specialization</td>
                    <td>@(t.IsPrimary ? "Yes" : "")</td>
                    <td>@t.LicenseNumber</td>
                    <td>@t.LicenseState</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<h2>Practice locations</h2>
<div class="table-wrap">
    <table>
        <thead><tr><th scope="col">Location</th><th scope="col">Address</th><th scope="col">City</th><th scope="col">State</th><th scope="col">ZIP</th><th scope="col">Phone</th></tr></thead>
        <tbody>
            @foreach (var l in p.Locations)
            {
                <tr>
                    <td>@(l.IsPrimary ? "Primary" : "Secondary")</td>
                    <td>@l.Address1@if (l.Address2 is not null){<br />@l.Address2}</td>
                    <td>@l.City</td>
                    <td>@l.State</td>
                    <td>@l.Zip@if (l.CountryCode is not null && l.CountryCode != "US"){<span class="muted"> (@l.CountryCode)</span>}</td>
                    <td>@Format.Phone(l.Phone)</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (p.Profile is { } profile && (profile.AuthorizedOfficial is not null || profile.ParentOrganization is not null || profile.MailingAddress is not null
                                   || profile.IsSoleProprietor == true || profile.PracticeFax is not null))
{
    <h2>Registration details</h2>
    <dl class="facts">
        @if (profile.AuthorizedOfficial is { } official)
        {
            <dt>Authorized official</dt>
            <dd>
                @official.Name@if (official.Credential is not null){<span>, @official.Credential</span>}
                @if (official.Title is not null){<br /><span class="muted">@official.Title</span>}
                @if (official.Phone is not null){<br />@Format.Phone(official.Phone)}
            </dd>
        }
        @if (profile.ParentOrganization is not null)
        {
            <dt>Parent organization</dt><dd>@profile.ParentOrganization@if (profile.IsOrganizationSubpart == true){<span class="muted"> (this NPI is a subpart)</span>}</dd>
        }
        @if (profile.IsSoleProprietor == true)
        {
            <dt>Sole proprietor</dt><dd>Yes</dd>
        }
        @if (profile.MailingAddress is { } mail)
        {
            <dt>Mailing address</dt>
            <dd>
                @mail.Address1@if (mail.Address2 is not null){<br />@mail.Address2}<br />
                @mail.City, @mail.State @mail.PostalCode@if (mail.CountryCode is not null && mail.CountryCode != "US"){<span> @mail.CountryCode</span>}
                @if (mail.Phone is not null){<br /><span>Phone @Format.Phone(mail.Phone)</span>}
                @if (mail.Fax is not null){<br /><span>Fax @Format.Phone(mail.Fax)</span>}
            </dd>
        }
        @if (profile.PracticeFax is not null)
        {
            <dt>Practice fax</dt><dd>@Format.Phone(profile.PracticeFax)</dd>
        }
    </dl>
}

@if (p.Endpoints.Count > 0)
{
    <h2>Electronic endpoints</h2>
    <div class="table-wrap">
        <table>
            <thead><tr><th scope="col">Type</th><th scope="col">Endpoint</th><th scope="col">Use</th><th scope="col">Affiliation</th></tr></thead>
            <tbody>
                @foreach (var e in p.Endpoints)
                {
                    <tr>
                        <td>@(e.TypeDescription ?? e.Type)</td>
                        <td class="break">@e.Endpoint@if (e.Description is not null){<br /><span class="muted">@e.Description</span>}</td>
                        <td>@e.Use</td>
                        <td>@e.AffiliationName@if (e.AffiliationCity is not null){<br /><span class="muted">@e.AffiliationCity, @e.AffiliationState</span>}</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (p.Identifiers.Count > 0)
{
    <h2>Other identifiers</h2>
    <div class="table-wrap">
        <table>
            <thead><tr><th scope="col">Identifier</th><th scope="col">Type</th><th scope="col">State</th><th scope="col">Issuer</th></tr></thead>
            <tbody>
                @foreach (var i in p.Identifiers)
                {
                    <tr><td>@i.Identifier</td><td>@i.Type</td><td>@i.State</td><td>@i.Issuer</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@if (p.OtherNames.Count > 0)
{
    <h2>Other names</h2>
    <ul>
        @foreach (var n in p.OtherNames)
        {
            <li>@n</li>
        }
    </ul>
}

@* Stage 5.5 item 11: what the loader saw change between NPPES files; NPPES itself publishes no history. *@
@if (p.Changes.Count > 0)
{
    <h2>Recorded changes</h2>
    <div class="table-wrap">
        <table>
            <thead><tr><th scope="col">Recorded</th><th scope="col">What changed</th><th scope="col">Before</th><th scope="col">After</th></tr></thead>
            <tbody>
                @foreach (var c in p.Changes)
                {
                    <tr>
                        <td>@c.RecordedOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                        <td>@(c.Type switch { "name" => "Name", "credential" => "Credential", "specialty" => "Primary specialty", "address" => "Primary practice address", _ => c.Type })</td>
                        <td>@(c.OldValue ?? "(none)")</td>
                        <td>@(c.NewValue ?? "(none)")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="muted">Changes are recorded from October 2026 on, as each NPPES update is loaded.</p>
}

<p class="muted">Verify details with the official <a href="https://npiregistry.cms.hhs.gov/provider-view/@p.Npi">NPPES NPI Registry</a>.</p>

@functions {
    private static string Count(double? value) => value is null ? "Suppressed" : value.Value.ToString("N0", CultureInfo.InvariantCulture);

    private static string Money(double? value) => value is null ? "Suppressed" : value.Value.ToString("$#,##0", CultureInfo.InvariantCulture);

    // An Open Payments amount: "—" for none, else the dollars and, when given, how many payments.
    private static string Amount(double value, int? records) => value <= 0 ? "—"
        : records is > 0 ? $"{Money(value)} ({records.Value.ToString("N0", CultureInfo.InvariantCulture)})" : Money(value);

    private static string Score(double? value) => value is null ? "—" : value.Value.ToString("0.#", CultureInfo.InvariantCulture);

    // Half stars, e.g. 3.5 → ★★★½☆ (3.5/5).
    private static string HalfStars(double? rating) => rating is >= 1 and <= 5
        ? new string('★', (int)rating.Value) + (rating.Value % 1 >= 0.5 ? "½" : "") + new string('☆', 5 - (int)Math.Ceiling(rating.Value))
          + $" ({rating.Value.ToString("0.#", CultureInfo.InvariantCulture)}/5)"
        : "Not rated";

    // "2 better, 1 worse of 11" (the rest are no different from the national rate).
    private static string Outcome(OutcomeCounts c) => c.Measures is not > 0 ? "Not available"
        : $"{c.Better ?? 0} better, {c.Worse ?? 0} worse than national, of {c.Measures}";

    private static string Stars(int? rating) => rating is >= 1 and <= 5 ? new string('★', rating.Value) + new string('☆', 5 - rating.Value) + $" ({rating}/5)" : "Not rated";
}
