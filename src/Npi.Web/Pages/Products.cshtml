@page "/products"
@model ProductsModel
@{
    ViewData["Title"] = "Products";
    var r = Model.Result;
}

<h1>Products in industry payments</h1>
<p>
    When a drug or device maker pays a doctor, it reports which of its products the payment was about. Find a product to see which companies pay
    for it, what for, and which providers they pay.
</p>

<form method="get" action="/products" class="inline-form" role="search">
    <label for="name">Product name</label>
    <input id="name" name="name" type="search" value="@Model.Name" maxlength="@Npi.Core.Search.ProductService.MaxNameLength" placeholder="e.g. Eliquis" />
    <label for="kind">Type</label>
    <select id="kind" name="kind">
        <option value="">Any</option>
        @foreach (var k in Npi.Core.Search.ProductService.Kinds)
        {
            <option value="@k" selected="@(k == Model.Kind)">@k</option>
        }
    </select>
    <button type="submit">Find</button>
</form>
@if (Model.Error is not null)
{
    <p class="error" role="alert">@Model.Error</p>
}

<p>
    @if (string.IsNullOrWhiteSpace(Model.Name))
    {
        <text>@Format.Number(r.TotalCount) products@(Model.Kind is null ? "" : $" ({Model.Kind})"), largest payments first.</text>
    }
    else
    {
        <text>@Format.Number(r.TotalCount) @(r.TotalCount == 1 ? "product matches" : "products match") “@Model.Name.Trim()”, largest payments first.</text>
    }
</p>

@if (r.Items.Count > 0)
{
    <div class="table-wrap">
        <table>
            <caption class="visually-hidden">Products</caption>
            <thead>
                <tr><th scope="col">Product</th><th scope="col">Type</th><th scope="col">Category</th><th scope="col">Payments naming it</th><th scope="col">Companies</th><th scope="col">Providers paid</th></tr>
            </thead>
            <tbody>
                @foreach (var p in r.Items)
                {
                    <tr>
                        <td><a href="/product/@p.Slug">@p.Name</a></td><td>@p.Kind</td><td>@p.Category</td>
                        <td>@Format.Money(p.Amount)</td><td>@Format.Number(p.Companies)</td><td>@Format.Number(p.Providers)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.PageCount > 1)
    {
        <nav class="pager" aria-label="Pages">
            @if (r.Page > 1) { <a href="@Model.PageUrl(r.Page - 1)" rel="prev">‹ Previous</a> }
            <span>Page @r.Page of @Format.Number(Model.PageCount)</span>
            @if (r.Page < Model.PageCount) { <a href="@Model.PageUrl(r.Page + 1)" rel="next">Next ›</a> }
        </nav>
    }
}

<p class="muted">Source: CMS Open Payments, newest program year, general payments. A payment can name several products and counts for each. Verify at <a href="https://openpaymentsdata.cms.gov/">openpaymentsdata.cms.gov</a>.</p>
