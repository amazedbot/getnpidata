@page "/owners"
@using Npi.Core.Search
@model OwnersModel
@{
    ViewData["Title"] = "Facility owners";
    var r = Model.Result;
}

<div class="profile industry">
    <nav aria-label="Breadcrumb" class="crumbs"><a href="/organizations">Groups &amp; organizations</a> › <a href="/facilities">Facilities &amp; hospitals</a></nav>
    <div>
        <h1>Facility owners</h1>
        <p class="lede">The companies and other organizations CMS lists as owners and managers of Medicare-certified hospitals, nursing homes, home health agencies, hospices, health centers and rural clinics. Find one to see every facility it owns or runs. People who own or run a facility are named on that facility's page only.</p>
    </div>

    <form method="get" action="/owners" class="directory-filters" role="search">
        <div class="field">
            <label for="q">Name or CMS associate ID</label>
            <input id="q" name="q" type="search" value="@Model.Q" maxlength="@OwnershipService.MaxQueryLength" placeholder="e.g. Lifepoint" />
        </div>

        <div class="field">
            <label for="kind">Kind of owner</label>
            <select id="kind" name="kind">
                <option value="">Any</option>
                @foreach (var (code, label) in OwnershipView.KindOptions)
                {
                    <option value="@code" selected="@(Model.Kind == code)">@label</option>
                }
            </select>
        </div>
        <div class="field narrow directory-submit"><button type="submit">Find</button></div>
    </form>
    @if (Model.Errors.Count > 0)
    {
        <p class="error" role="alert">@string.Join(" ", Model.Errors.Select(e => $"{e.Key}: {string.Join(" ", e.Value)}")) The list below has no filters.</p>
    }

    <section class="card" aria-labelledby="list-h">
        <div class="card-head">
            <h2 id="list-h">@Format.Number(r.TotalCount) @(r.TotalCount == 1 ? "organization" : "organizations")@(Model.Q is { } q ? $" matching “{q}”" : ""), those owning the most facilities first</h2>
            <a class="small" href="@Model.ApiUrl">As JSON (API)</a>
        </div>
        @if (r.Items.Count == 0)
        {
            <p>No organization matches. Try part of the name, or a CMS associate ID (up to 10 digits).</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <caption class="visually-hidden">Facility owners</caption>
                    <thead><tr><th scope="col">Owner</th><th scope="col">Based in</th><th scope="col">Facilities</th><th scope="col">Owns</th></tr></thead>
                    <tbody>
                        @foreach (var o in r.Items)
                        {
                            <tr>
                                <td>
                                    <a href="/owner/@o.Id">@OwnershipView.DisplayName(o.Name)</a>
                                    @if (o.Kinds.Count > 0)
                                    {
                                        <br /><span class="small muted">@string.Join(" · ", o.Kinds.Take(3).Select(k => OwnerKinds.Label(k) ?? k))</span>
                                    }
                                </td>
                                <td>@OwnershipView.Place(o.City, o.State)</td>
                                <td>@Format.Number(o.Facilities)</td>
                                <td>@Format.Number(o.Owned)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.PageCount > 1)
            {
                <nav class="pager" aria-label="Pages">
                    @if (r.Page > 1) { <a href="@Model.PageUrl(r.Page - 1)" rel="prev">‹ Previous</a> }
                    <span>Page @r.Page of @Format.Number(Model.PageCount)</span>
                    @if (r.Page < Model.PageCount) { <a href="@Model.PageUrl(r.Page + 1)" rel="next">Next ›</a> }
                </nav>
            }
        }
        <p class="src">CMS All Owners files of hospitals, skilled nursing facilities, home health agencies, hospices, FQHCs and rural health clinics. "Facilities" counts the facilities an owner is listed for in any role (owner, manager, officer or director), "Owns" those with an ownership interest. People (officers, managing employees, individual owners) are not listed here.</p>
    </section>
</div>
