@page "/map"
@using System.Globalization
@using Npi.Core.Search
@model MapModel
@{
    ViewData["Title"] = "Map search";
}

<h1>Map search</h1>
<p class="lede">Move the map to an area and choose <strong>Search in this area</strong>. Pins mark practice addresses; hover a pin to see who practices there.</p>

<noscript><p class="notice">The map search needs JavaScript. The <a href="/search">search page</a> works without it.</p></noscript>

<div class="builder map-builder">
    @* The same filters as the search page's list builder (specialty first, the rest folded away); the place is the map itself, so there
       are no location fields, and the one search button is the map's own "Search in this area" (it submits this form). *@
    <form method="get" action="/map" class="search filters" id="search-form" aria-label="Filters">
        <partial name="_SpecialtyFields" model="Model.Fields" />

        <details class="more" open="@Model.Fields.MoreOpen">
            <summary>More filters: name, NPI, credential, Medicare, dates…@if (Model.Fields.MoreCount > 0){<span class="more-count"> (@Model.Fields.MoreCount set)</span>}</summary>
            <partial name="_ProviderFields" model="Model.Fields" />
        </details>

        <p class="muted small">Filters apply when you search the map area.</p>
        <div class="actions">
            <a href="/map" class="secondary">Clear filters</a>
        </div>
    </form>

    <div class="results-col map-col">
        <div class="map-pane">
            <div class="map-toolbar">
                <button type="submit" form="search-form" id="search-area">Search in this area</button>
                <button type="button" class="secondary" id="near-me" hidden>Near me</button>
            </div>
            <p class="muted" id="map-status" role="status" aria-live="polite"></p>
            <div id="area-map" class="area-map" role="region" aria-label="Map"
                 data-tile-url="@Model.Map.TileUrl" data-attribution="@Model.Map.Attribution" data-max-zoom="@Model.Map.MaxZoom"
                 data-start="@Model.StartText" data-auto-search="@(Model.AutoSearch ? "true" : "false")"
                 data-max-lat-span="@MapBounds.MaxLatSpan.ToString(CultureInfo.InvariantCulture)" data-max-lon-span="@MapBounds.MaxLonSpan.ToString(CultureInfo.InvariantCulture)"></div>
            <p class="muted small legend">
                <span><span class="dot exact" aria-hidden="true"></span>At the building</span>
                <span><span class="dot street" aria-hidden="true"></span>Estimated along the street</span>
                <span><span class="dot approximate" aria-hidden="true"></span>Approximate (ZIP code center: the address couldn't be located)</span>
                <span>Locations: <a href="https://overturemaps.org/">Overture Maps Foundation</a> (US DOT National Address Database, places), US Census Bureau geocoder.</span>
            </p>
        </div>

        <section class="area-results" aria-labelledby="area-heading">
            <div class="area-head">
                <h2 id="area-heading">Providers in view</h2>
                <div class="area-sort">
                    <label for="area-sort">Sort by</label>
                    <select id="area-sort">
                        <option value="distance">Distance from map center</option>
                        <option value="name">Name</option>
                        <option value="specialty">Specialty</option>
                        <option value="city">City</option>
                        <option value="updated">Last updated</option>
                    </select>
                    <label for="area-order" class="visually-hidden">Order</label>
                    <select id="area-order">
                        <option value="asc">Ascending</option>
                        <option value="desc">Descending</option>
                    </select>
                </div>
            </div>
            <p class="muted" id="area-count">Search an area to list its providers.</p>
            <div class="table-wrap area-table-wrap">
                <table id="area-table">
                    <caption class="visually-hidden">Providers at the pins currently visible on the map</caption>
                    <thead>
                        <tr>
                            <th scope="col">Provider</th>
                            <th scope="col">Address</th>
                            <th scope="col">Phone</th>
                            <th scope="col">Miles</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>
    </div>
</div>

@section Head {
    @* The first map tile is the largest paint: connect to the tile server early and fetch Leaflet while the page is read; the scripts
       are deferred so they don't hold up the first paint (docs/PRODUCT_PLAN.md step 1.9). *@
    @if (Model.TileOrigin is { } tiles){<link rel="preconnect" href="@tiles" />}
    <link rel="preload" as="script" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js" integrity="sha512-BwHfrr4c9kmRkLw6iXFdzcdWV/PGkVgiIyIWLLlTSXzWQzxuSg4DiQUCpauz/EWjgk5TYQqX/kvn9pG1NpYfqg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <partial name="_LeafletCss" />
}

@section Scripts {
    <script src="~/js/search.js" asp-append-version="true" defer></script>
    <script src="~/js/combo.js" asp-append-version="true" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"
            integrity="sha512-BwHfrr4c9kmRkLw6iXFdzcdWV/PGkVgiIyIWLLlTSXzWQzxuSg4DiQUCpauz/EWjgk5TYQqX/kvn9pG1NpYfqg==" crossorigin="anonymous" referrerpolicy="no-referrer" defer></script>
    <script src="~/js/map.js" asp-append-version="true" defer></script>
}
