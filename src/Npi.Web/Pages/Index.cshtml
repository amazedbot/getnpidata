@page
@using System.Globalization
@using Npi.Core.Search
@model IndexModel
@{
    ViewData["Title"] = "Search providers";
    var f = Model.Filter;
}

<h1>Search US healthcare providers</h1>
<p class="lede">Search every active provider in the CMS NPPES registry by specialty, location, name or NPI.</p>

<form method="get" action="/" class="search" id="search-form">
    @if (Model.Errors.TryGetValue("filter", out var general))
    {
        <p class="error" role="alert">@string.Join(" ", general)</p>
    }

    <partial name="_SpecialtyFields" model="Model.Fields" />

    <fieldset>
        <legend>Location</legend>
        <div class="field">
            <label for="state">State</label>
            <select id="state" name="state" data-dependent="county" data-source="/lookup/counties?state=">
                <option value="">Any</option>
                @foreach (var s in Model.States)
                {
                    <option value="@s.Code" selected="@(string.Equals(s.Code, f.State, StringComparison.OrdinalIgnoreCase))">@s.Name</option>
                }
            </select>
            <span class="field-error">@Model.Error(nameof(SearchFilter.State))</span>
        </div>
        <div class="field">
            <label for="county">County</label>
            <select id="county" name="county" disabled="@(Model.Counties.Count == 0)">
                <option value="">Any</option>
                @foreach (var c in Model.Counties)
                {
                    <option value="@c.Fips" selected="@(c.Fips == f.CountyFips)">@c.Name</option>
                }
            </select>
            <span class="field-error">@Model.Error(nameof(SearchFilter.CountyFips))</span>
        </div>
        <div class="field">
            <label for="city">City</label>
            <input id="city" name="city" value="@f.City" maxlength="60" autocomplete="address-level2" />
        </div>
        <div class="field narrow">
            <label for="zip">ZIP</label>
            <input id="zip" name="zip" value="@f.Zip5" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" autocomplete="postal-code" />
            <span class="field-error">@Model.Error(nameof(SearchFilter.Zip5))</span>
        </div>
        <div class="field narrow">
            <label for="radius">Within</label>
            <select id="radius" name="radius">
                <option value="">ZIP only</option>
                @foreach (var r in IndexModel.RadiusChoices)
                {
                    <option value="@r" selected="@(r == f.RadiusMiles)">@r miles</option>
                }
            </select>
            <span class="field-error">@Model.Error(nameof(SearchFilter.RadiusMiles))</span>
        </div>
    </fieldset>

    <partial name="_ProviderFields" model="Model.Fields" />

    <div class="actions">
        <button type="submit">Search</button>
        <a href="/" class="secondary">Clear</a>
    </div>
</form>

@if (Model.Result is { } result)
{
    <section aria-labelledby="results-heading" class="results">
        <div class="results-head">
            <h2 id="results-heading">@result.TotalCount.ToString("N0", CultureInfo.InvariantCulture) provider@(result.TotalCount == 1 ? "" : "s") found</h2>
            @if (result.TotalCount > 0)
            {
                <span class="results-actions">
                    <a class="button secondary" href="@Model.MapLink">View on map</a>
                    <a class="button" href="@Model.CsvLink" download>Download CSV</a>
                </span>
            }
        </div>

        @if (Model.County is { } county)
        {
            <aside class="notice" aria-label="About @county.Name">
                <strong>@county.Name, @county.State</strong>
                @if (county.Population is { } population && population > 0)
                {
                    <span> · population @population.ToString("N0", CultureInfo.InvariantCulture) (@county.PopulationYear)
                        · @((10000.0 * result.TotalCount / population).ToString("0.0", CultureInfo.InvariantCulture)) matching providers per 10,000 residents</span>
                }
                @if (county.Shortages.Count > 0)
                {
                    <br /><span>HRSA shortage areas: @string.Join("; ", county.Shortages.Select(s => $"{s.DisciplineName} ({(s.WholeCounty ? "whole county" : $"{s.ShortageAreas} area{(s.ShortageAreas == 1 ? "" : "s")}")})"))</span>
                }
                else
                {
                    <br /><span class="muted">No HRSA shortage areas in force.</span>
                }
            </aside>
        }

        @if (result.TotalCount > 0)
        {
            <div class="table-wrap">
                <table>
                    <caption class="visually-hidden">Search results, page @result.Page of @Model.PageCount</caption>
                    <thead>
                        <tr>
                            <th scope="col" aria-sort="@Model.AriaSort(SearchSort.Npi)"><a href="@Model.SortLink(SearchSort.Npi)">NPI</a></th>
                            <th scope="col" aria-sort="@Model.AriaSort(SearchSort.Name)"><a href="@Model.SortLink(SearchSort.Name)">Name</a></th>
                            <th scope="col" aria-sort="@Model.AriaSort(SearchSort.Credential)"><a href="@Model.SortLink(SearchSort.Credential)">Credential</a></th>
                            <th scope="col">Primary specialty</th>
                            <th scope="col">Address</th>
                            <th scope="col" aria-sort="@Model.AriaSort(SearchSort.City)"><a href="@Model.SortLink(SearchSort.City)">City</a></th>
                            <th scope="col" aria-sort="@Model.AriaSort(SearchSort.State)"><a href="@Model.SortLink(SearchSort.State)">State</a></th>
                            <th scope="col" aria-sort="@Model.AriaSort(SearchSort.Zip)"><a href="@Model.SortLink(SearchSort.Zip)">ZIP</a></th>
                            <th scope="col">County</th>
                            <th scope="col">Phone</th>
                            <th scope="col" aria-sort="@Model.AriaSort(SearchSort.LastUpdate)"><a href="@Model.SortLink(SearchSort.LastUpdate)">Updated</a></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in result.Items)
                        {
                            <tr>
                                <td><a href="/provider/@p.Npi">@p.Npi</a></td>
                                <td>
                                    @p.Name <span class="muted">(@p.EntityTypeName)</span>
                                    @if (p.Flags.Excluded)
                                    {
                                        <span class="badge alert" title="On the HHS-OIG List of Excluded Individuals/Entities">OIG excluded</span>
                                    }
                                    @if (p.Flags.OptedOutOfMedicare)
                                    {
                                        <span class="badge" title="Has an active Medicare opt-out affidavit">Medicare opt-out</span>
                                    }
                                    @if (p.Flags.AcceptsMedicareAssignment)
                                    {
                                        <span class="badge good" title="Accepts Medicare's approved amount as full payment (Care Compare)">Accepts Medicare</span>
                                    }
                                    @if (p.Flags.OffersTelehealth)
                                    {
                                        <span class="badge good" title="Offers telehealth (Care Compare)">Telehealth</span>
                                    }
                                </td>
                                <td>@p.Credential</td>
                                <td>@p.PrimarySpecialty</td>
                                <td>@p.Address1@if (p.Address2 is not null){<br />@p.Address2}</td>
                                <td>@p.City</td>
                                <td>@p.State</td>
                                <td>@p.Zip</td>
                                <td>@p.County</td>
                                <td>@Npi.Web.Pages.Format.Phone(p.Phone)</td>
                                <td>@p.LastUpdateDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <nav class="pager" aria-label="Result pages">
                @if (result.Page > 1)
                {
                    <a href="@Model.PageLink(result.Page - 1)" rel="prev">‹ Previous</a>
                }
                <span>Page @result.Page of @Model.PageCount.ToString("N0", CultureInfo.InvariantCulture)</span>
                @if (result.Page < Model.PageCount && (long)result.Page * result.PageSize < SearchFilter.MaxResultWindow)
                {
                    <a href="@Model.PageLink(result.Page + 1)" rel="next">Next ›</a>
                }
            </nav>
            @if (result.TotalCount > SearchFilter.MaxResultWindow)
            {
                <p class="muted">Browsing is limited to the first @SearchFilter.MaxResultWindow.ToString("N0", CultureInfo.InvariantCulture) results. Narrow the search, or download the CSV for all of them.</p>
            }
        }
        else
        {
            <p>No active providers match. Try fewer filters.</p>
        }
    </section>
}

@section Scripts {
    <script src="~/js/search.js" asp-append-version="true"></script>
    <script src="~/js/combo.js" asp-append-version="true"></script>
}
