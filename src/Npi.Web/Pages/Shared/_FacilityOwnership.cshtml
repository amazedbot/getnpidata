@using Npi.Core.Search
@model FacilityOwnershipSection
@*
    Who owns and runs a facility, and its ownership changes (docs/PRODUCT_PLAN.md step 3.6 part 2). On an organization's page
    (step 3.9) the owners of all its facilities, each once with the facilities it holds a role in, and the changes of any of them.
*@
@{
    var o = Model.Ownership;
    var combined = Model.Combined;
    var groups = combined is not null ? OwnershipView.Groups(combined) : o is null ? [] : OwnershipView.Groups(o.Owners);
    var owners = combined is not null ? combined.Owners.Count : o?.Owners.Count ?? 0;
    var changes = combined?.Changes ?? o?.Changes ?? [];
    var changesAsOf = combined?.ChangesAsOf ?? o?.ChangesAsOf;
    var listed = combined is not null || o is not null;
    var showFacilities = Model.ShowFacilities;
}

@if (listed || Model.OwnersPublished)
{
<section class="card" id="owners" aria-labelledby="owners-h">
    <h2 id="owners-h">Who owns it</h2>
    @if (owners == 0)
    {
        <p>CMS lists no owners for @(combined is null ? "this facility's Medicare enrollment" : "the Medicare enrollments of its facilities").</p>
    }
    else
    {
        @if (combined is not null)
        {
            <p class="lede">The owners and managers of its facilities' Medicare enrollments, as the facilities reported them to CMS@(showFacilities ? "; each is listed once, with the facilities it holds a role in" : "").</p>
        }
        else
        {
            <p class="lede">The owners and managers of its Medicare enrollment@(o!.LegalName is { } legal ? $" ({OwnershipView.DisplayName(legal)})" : ""), as the facility reported them to CMS.</p>
        }
        @foreach (var (group, lines) in groups)
        {
            <h3>@OwnerRoles.GroupName(group) (@lines.Count)</h3>
            @if (group == OwnerRoles.Officer)
            {
                @:<details><summary>Show the @lines.Count @(lines.Count == 1 ? "person or company" : "people and companies")</summary>
            }
            <div class="table-wrap">
                <table>
                    <caption class="visually-hidden">@OwnerRoles.GroupName(group)</caption>
                    <thead><tr><th scope="col">Name</th><th scope="col">Role</th><th scope="col">Share</th><th scope="col">Since</th>@if (showFacilities){<th scope="col">Facilities</th>}</tr></thead>
                    <tbody>
                        @foreach (var l in lines)
                        {
                            <tr>
                                <td>
                                    @if (l.OwnerId is { } ownerId){<a href="/owner/@ownerId">@l.Name</a>}else{@l.Name}@if (l.DoingBusinessAs is { } dba && !string.Equals(dba, l.Name, StringComparison.OrdinalIgnoreCase)){<span class="muted"> (doing business as @dba)</span>}
                                    @if (l.Title is { } title){<br /><span class="small muted">@title</span>}
                                    @if (l.Kinds.Count > 0 || l.Place is not null)
                                    {
                                        <br /><span class="small muted">@string.Join(" · ", l.Kinds.Append(l.Place).Where(x => !string.IsNullOrEmpty(x)))</span>
                                    }
                                </td>
                                <td>@l.Roles</td>
                                <td>@OwnershipView.Share(l.Percentage)</td>
                                <td>@OwnershipView.Date(l.Since)</td>
                                @if (showFacilities)
                                {
                                    <td class="small">
                                        @for (var i = 0; i < l.Facilities.Count; i++)
                                        {
                                            var fac = l.Facilities[i];
                                            @(i > 0 ? "; " : "")<a href="@(Model.Anchored.Contains(fac.Ccn) ? "#fac-" + fac.Ccn : "/facility/" + fac.Ccn)">@CityCatalog.TitleCase(fac.Facility)</a><span class="muted"> (@fac.Ccn@(l.Facilities.Select(x => x.Roles).Distinct().Count() > 1 ? ": " + fac.Roles.ToLowerInvariant() : "")@(fac.Percentage is > 0 && fac.Percentage != l.Percentage ? ", " + OwnershipView.Share(fac.Percentage) : ""))</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (group == OwnerRoles.Officer)
            {
                @:</details>
            }
        }
        <p class="src">
            @if (combined is not null)
            {
                <text>CMS All Owners files (Medicare enrollments @string.Join(", ", combined.Enrollments.Take(6).Select(e => $"{e.EnrollmentId} for {e.Ccn}"))@(combined.Enrollments.Count > 6 ? $" and {combined.Enrollments.Count - 6} more" : ""))@(combined.OwnersAsOf is { } cAsOf ? ", data as of " + OwnershipView.Date(cAsOf, "MMMM d, yyyy") : "").
                    An owner listed for several facilities is shown once; people are joined by name within this organization only.</text>
            }
            else
            {
                <text>CMS @(TypeName(Model.FacilityType)) All Owners file (Medicare enrollment @o!.EnrollmentId)@(o.OwnersAsOf is { } asOf ? ", data as of " + OwnershipView.Date(asOf, "MMMM d, yyyy") : "").</text>
            }
            Owners of 5% or more must be listed; an indirect owner owns the facility through another company. Each organization's name opens every facility CMS lists it for; people are named here only.
        </p>
    }
</section>
}

@if (changes.Count > 0 || Model.ChangesPublished)
{
    <section class="card" id="ownership-changes" aria-labelledby="chow-h">
        <h2 id="chow-h">Ownership changes@(changes.Count > 0 ? $" ({changes.Count})" : "")</h2>
        @if (changes.Count == 0)
        {
            <p>CMS recorded no change of ownership for @(combined is null ? "this facility" : "its facilities") since 2016.</p>
        }
        else
        {
            <ol class="link-list">
                @foreach (var c in changes)
                {
                    <li>
                        <strong>@OwnershipView.Date(c.EffectiveDate, "MMMM d, yyyy")</strong> · @c.Type:
                        @Party(c.SellerName, c.SellerDoingBusinessAs, c.SellerId) to @Party(c.BuyerName, c.BuyerDoingBusinessAs, c.BuyerId)
                        @if (combined is not null && (c.BuyerCcn ?? c.SellerCcn) is { } changed)
                        {
                            <span class="small muted">(CCN <a href="/facility/@changed">@changed</a>)</span>
                        }
                        @if (c.SellerCcn is { } sccn && c.BuyerCcn is { } bccn && !string.Equals(sccn, bccn, StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="small muted">(merged: <a href="/facility/@sccn">@sccn</a> into <a href="/facility/@bccn">@bccn</a>)</span>
                        }
                        @if (c.PreviousOwners.Count > 0)
                        {
                            <br /><span class="small muted">Owned before by
                            @for (var i = 0; i < c.PreviousOwners.Count && i < 6; i++)
                            {
                                var p = c.PreviousOwners[i];
                                @(i > 0 ? "; " : "")@if (p.OwnerId is { } previousId){<a href="/owner/@previousId">@OwnershipView.DisplayName(p.Name)</a>}else{@OwnershipView.DisplayName(p.Name)}@($" ({p.Role.ToLowerInvariant()}{(p.Percentage is > 0 ? ", " + OwnershipView.Share(p.Percentage) : "")})")
                            }
                            @(c.PreviousOwners.Count > 6 ? $" and {c.PreviousOwners.Count - 6} more" : "")</span>
                        }
                    </li>
                }
            </ol>
        }
        <p class="src">CMS Hospital and Skilled Nursing Facility Change of Ownership files and their owner information (changes since 2016)@(changesAsOf is { } asOfChanges ? ", data as of " + OwnershipView.Date(asOfChanges, "MMMM d, yyyy") : ""). CMS publishes no such file for other kinds of facility.</p>
    </section>
}

@functions {
    private static string TypeName(string type) => type switch
    {
        FacilityTypes.Hospital => "Hospital",
        FacilityTypes.NursingHome => "Skilled Nursing Facility",
        FacilityTypes.HomeHealth => "Home Health Agency",
        FacilityTypes.Hospice => "Hospice",
        FacilityTypes.Fqhc => "Federally Qualified Health Center",
        FacilityTypes.Rhc => "Rural Health Clinic",
        _ => "facility",
    };

    // The buyer and the seller are the enrolled organizations (their associate IDs need not be owners elsewhere): named, not linked.
    private static string Party(string? name, string? dba, string? id) => OwnershipView.DisplayName(name ?? dba ?? (id is null ? "an unnamed party" : "associate " + id));
}
