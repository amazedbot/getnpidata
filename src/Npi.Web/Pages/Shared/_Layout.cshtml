@using System.Globalization
@inject Npi.Core.Search.GeographyCatalog Geography
@{
    var version = await Geography.GetDataVersionAsync(Context.RequestAborted);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – getnpidata</title>
    @await RenderSectionAsync("Head", required: false)
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip" href="#main">Skip to content</a>
    <header>
        <a class="brand" href="/">getnpidata</a>
        <nav aria-label="Site"><a href="/">Search</a> · <a href="/map">Map</a> · <a href="/lookup">Bulk lookup</a> · <a href="/companies">Companies</a> · <a href="/swagger">API</a></nav>
        <span class="muted">US healthcare provider search</span>
    </header>
    <main id="main">
        @RenderBody()
    </main>
    <footer>
        <p>
            Data as of <strong>@(version?.AsOfDate?.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture) ?? "unknown")</strong>
            @if (version is not null)
            {
                <span>· @version.ProviderCount.ToString("N0", CultureInfo.InvariantCulture) active providers</span>
            }
        </p>
        <p>
            Source: <a href="https://download.cms.gov/nppes/NPI_Files.html">CMS NPPES</a> data dissemination files.
            This is public NPPES information; deactivated NPIs are not shown. Counties via the HUD USPS ZIP–County crosswalk,
            specialties via the NUCC Health Care Provider Taxonomy.
        </p>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
