@using Npi.Core.Search
@model Npi.Web.Pages.FilterFields
@*
    Shared by the search page and the map page (CLAUDE.md §7 Stage 5.5 item 10), so both offer the same filters.
    Plain categories first (SpecialtyCategories, owner 2026-10-11); NUCC's own classification/specialization stay available,
    folded away, for credentialing and for older links.
*@
<fieldset>
    <legend>Specialty</legend>
    <div class="field">
        <label for="category">Category</label>
        <select id="category" name="category" data-dependent="subcategory" data-source="/lookup/subcategories?category=">
            <option value="">Any</option>
            @foreach (var c in Model.Categories)
            {
                <option value="@c" selected="@(string.Equals(c, Model.Filter.Category, StringComparison.OrdinalIgnoreCase))">@c</option>
            }
        </select>
        <span class="field-error">@Model.Error(nameof(SearchFilter.Category))</span>
    </div>
    <div class="field">
        <label for="subcategory">Subcategory</label>
        <select id="subcategory" name="subcategory" disabled="@(Model.Subcategories.Count == 0)">
            <option value="">Any</option>
            @foreach (var s in Model.Subcategories)
            {
                <option value="@s" selected="@(string.Equals(s, Model.Filter.Subcategory, StringComparison.OrdinalIgnoreCase))">@s</option>
            }
        </select>
        <span class="field-error">@Model.Error(nameof(SearchFilter.Subcategory))</span>
    </div>
    <details class="nucc" open="@Model.NuccOpen">
        <summary>Exact NUCC taxonomy</summary>
        <p class="muted small">The official classification and specialization, as providers list them in NPPES.</p>
        <div class="field">
            <label for="classification">Classification</label>
            <select id="classification" name="classification" data-dependent="specialization" data-source="/lookup/specializations?classification=">
                <option value="">Any</option>
                @foreach (var c in Model.Classifications)
                {
                    <option value="@c" selected="@(string.Equals(c, Model.Filter.Classification, StringComparison.OrdinalIgnoreCase))">@c</option>
                }
            </select>
            <span class="field-error">@Model.Error(nameof(SearchFilter.Classification))</span>
        </div>
        <div class="field">
            <label for="specialization">Specialization</label>
            <select id="specialization" name="specialization" disabled="@(Model.Specializations.Count == 0)">
                <option value="">Any</option>
                @foreach (var s in Model.Specializations)
                {
                    <option value="@s" selected="@(string.Equals(s, Model.Filter.Specialization, StringComparison.OrdinalIgnoreCase))">@s</option>
                }
            </select>
            <span class="field-error">@Model.Error(nameof(SearchFilter.Specialization))</span>
        </div>
    </details>
</fieldset>
