@using System.Globalization
@using Npi.Core.Search
@model ProviderHistory
@*
    An NPI's record over the years in the archived monthly NPPES files (docs/PRODUCT_PLAN.md step 3.4): the provider page's "Over the
    years", and the main NPI's on an organization's page (step 3.9).
*@
@{
    var past = Model;
}
<p>@(past.InFirstFile
        ? $"In the archived NPPES files since the first one ({AreaHistoryMath.MonthName(past.ArchiveFrom)})"
        : $"First listed in the {past.FirstListed.ToString("MMMM yyyy", CultureInfo.InvariantCulture)} file")@(past.Versions.Count == 1
        ? ", with no change in its location, specialty or status since."
        : $"; {past.Versions.Count - 1} change{(past.Versions.Count == 2 ? "" : "s")} seen from one monthly file to the next up to {AreaHistoryMath.MonthName(past.ArchiveTo)}.")</p>
@{
    void Version(ProviderHistoryVersion v)
    {
        <li>
            <strong title="@v.Source">@v.ListedFrom.ToString("MMMM yyyy", CultureInfo.InvariantCulture)</strong>
            <ul>
                @foreach (var c in v.Changes)
                {
                    <li>@c.Text</li>
                }
            </ul>
            @if (v.MonthsWithoutFileBefore.Count > 0)
            {
                <span class="muted">No file survives for @string.Join(", ", v.MonthsWithoutFileBefore.Select(AreaHistoryMath.MonthName)), so it may date from then.</span>
            }
        </li>
    }
}
<ol class="history-list" reversed>
    @foreach (var v in past.Versions.Take(ProviderModel.HistoryShown))
    {
        Version(v);
    }
</ol>
@if (past.Versions.Count > ProviderModel.HistoryShown)
{
    <details>
        <summary>Show all @past.Versions.Count versions</summary>
        <ol class="history-list" reversed start="@(past.Versions.Count - ProviderModel.HistoryShown)">
            @foreach (var v in past.Versions.Skip(ProviderModel.HistoryShown))
            {
                Version(v);
            }
        </ol>
    </details>
}
<p class="src">From the archived monthly NPPES files, @AreaHistoryMath.MonthName(past.ArchiveFrom) to @AreaHistoryMath.MonthName(past.ArchiveTo)
    (@ProviderHistory.Attribution before June 2015, <a href="@ProviderHistory.Doi">doi.org/10.60592/bjwk-8n62</a>), each compared with the one before:
    the primary practice location (and from @(past.SecondaryFrom is { } sf ? AreaHistoryMath.MonthName(sf) : "July 2018") the other practice locations),
    the specialties, the status and the dates. A change is dated by the first file that shows it. Changes since then are under Changes.</p>
