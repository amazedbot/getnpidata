@page "/product/{slug}"
@using System.Globalization
@model ProductModel
@{
    var p = Model.Product;
    ViewData["Title"] = p.Name;
}

<p><a href="/products">‹ All products</a></p>

<h1>@p.Name</h1>

<dl class="facts">
    @if (p.Kind is not null)
    {
        <dt>Type</dt><dd>@p.Kind</dd>
    }
    @if (p.Category is not null)
    {
        <dt>Category</dt><dd>@p.Category</dd>
    }
    @if (p.Ndc is not null)
    {
        <dt>NDC (drug code)</dt><dd>@p.Ndc</dd>
    }
    @if (p.DeviceId is not null)
    {
        <dt>Device identifier</dt><dd>@p.DeviceId</dd>
    }
    <dt>Companies paying</dt><dd>@Format.Number(p.CompanyCount)</dd>
    <dt>Providers paid</dt><dd>@Format.Number(p.Providers)</dd>
</dl>

<p>
    <strong>@Format.Money(p.Amount)</strong> in @Format.Number(p.Records) general payment@(p.Records == 1 ? "" : "s") naming this product in @p.Year
    (meals, consulting, speaking, travel …), from @Format.Number(p.CompanyCount) @(p.CompanyCount == 1 ? "company" : "companies")
    to @Format.Number(p.Providers) providers@(p.Research is { } r0 ? $", plus {Format.Money(r0.Amount)} of research payments" : "").
</p>
<div class="notice" role="note">
    Drug and device makers report every payment to doctors and teaching hospitals, and which products it was about (the Sunshine Act).
    A payment is not evidence of wrongdoing, but you may want to know about it when your provider recommends this product.
</div>

@if (p.Drug is { } drug)
{
    @if (drug.BoxedWarning is not null)
    {
        <div class="notice alert" role="note">
            <strong>FDA boxed warning</strong> (the most serious kind of warning on a drug label):
            <p class="prewrap">@Clip(drug.BoxedWarning, 1500)</p>
            @if (drug.DailyMedUrl is not null) { <a href="@drug.DailyMedUrl">Read the full label on DailyMed</a> }
        </div>
    }
    <h2>About this @(p.Kind?.ToLowerInvariant() == "biological" ? "biological" : "drug")</h2>
    <dl class="facts">
        @if (drug.BrandName is not null) { <dt>Brand name</dt><dd>@drug.BrandName</dd> }
        @if (drug.GenericName is not null) { <dt>Generic name</dt><dd>@drug.GenericName</dd> }
        @if (drug.ActiveIngredients is not null) { <dt>Active ingredients</dt><dd>@drug.ActiveIngredients</dd> }
        @if (drug.PharmClasses is not null) { <dt>Drug class</dt><dd>@drug.PharmClasses</dd> }
        @if (drug.DosageForm is not null || drug.Route is not null) { <dt>Form</dt><dd>@string.Join(", ", new[] { drug.DosageForm?.ToLowerInvariant(), drug.Route?.ToLowerInvariant() }.Where(x => x is not null))</dd> }
        @if (drug.ProductType is not null) { <dt>Type</dt><dd>@drug.ProductType.ToLowerInvariant()</dd> }
        @if (drug.Labeler is not null) { <dt>Labeler</dt><dd>@drug.Labeler</dd> }
        @if (drug.ApplicationNumber is not null)
        {
            <dt>FDA application</dt>
            <dd>
                @if (drug.DrugsAtFdaUrl is not null){<a href="@drug.DrugsAtFdaUrl">@drug.ApplicationNumber</a>}else{@drug.ApplicationNumber}
                @if (drug.MarketingCategory is not null){<span class="muted"> (@drug.MarketingCategory)</span>}
                @if (drug.Sponsor is not null){<span class="muted">, held by @drug.Sponsor</span>}
            </dd>
        }
        else if (drug.MarketingCategory is not null) { <dt>Marketing category</dt><dd>@drug.MarketingCategory</dd> }
        @if (drug.ApprovalDate is { } approved) { <dt>First approved</dt><dd>@approved.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</dd> }
        else if (drug.MarketingStart is { } start) { <dt>On the market since</dt><dd>@start.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</dd> }
        <dt>Other makers</dt>
        <dd>@(drug.OtherMakers == 0 ? "None listed: no generic or other version of the same ingredients is listed with FDA"
              : $"{Format.Number(drug.OtherMakers)} other {(drug.OtherMakers == 1 ? "company lists" : "companies list")} the same ingredients" + (drug.GenericMakers > 0 ? $", {Format.Number(drug.GenericMakers)} with an approved generic" : ""))</dd>
    </dl>
    @if (drug.Indications is not null)
    {
        <h3>What it's approved for</h3>
        <details>
            <summary>@Clip(drug.Indications, 300)</summary>
            <p class="prewrap">@drug.Indications</p>
        </details>
        <p class="muted">From the FDA drug label@(drug.LabelDate is { } ld ? $" of {ld.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)}" : "")@(drug.DailyMedUrl is null ? "." : "")
            @if (drug.DailyMedUrl is not null){<text>; the full label (dosage, side effects, interactions) is on <a href="@drug.DailyMedUrl">DailyMed</a>.</text>}</p>
    }
    <p class="muted">FDA's NDC directory and Drugs@FDA, matched by the product's NDC @drug.ProductNdc as reported in the payments. Not medical advice: ask your doctor or pharmacist.</p>
}

@if (p.Device is { } device)
{
    <h2>About this device</h2>
    <p class="muted">FDA's device database (GUDID) record of the device identifier named most in the payments: one model of the product line.</p>
    <dl class="facts">
        @if (device.BrandName is not null) { <dt>Brand</dt><dd>@device.BrandName</dd> }
        @if (device.Company is not null) { <dt>Company</dt><dd>@device.Company</dd> }
        @if (device.Description is not null) { <dt>Model described</dt><dd>@device.Description@if (device.Model is not null){<span class="muted"> (@device.Model)</span>}</dd> }
        @if (device.GmdnTerm is not null) { <dt>Device type</dt><dd>@device.GmdnTerm</dd> }
        @if (device.ProductCode is not null) { <dt>FDA product code</dt><dd>@device.ProductCode@if (device.ProductCodeName is not null){<text> · @device.ProductCodeName</text>}</dd> }
        @if (device.DeviceClass is not null) { <dt>FDA class</dt><dd>Class @device.DeviceClass @(device.DeviceClass switch { "1" => "(lowest risk)", "2" => "(moderate risk)", "3" => "(highest risk)", _ => "" })</dd> }
        @if (device.MedicalSpecialty is not null) { <dt>Specialty</dt><dd>@device.MedicalSpecialty</dd> }
        @if (device.IsRx is not null || device.IsOtc is not null) { <dt>Sold</dt><dd>@(device.IsRx == true ? "by prescription" : device.IsOtc == true ? "over the counter" : "—")</dd> }
        @if (device.Implantable == true) { <dt>Implant</dt><dd>Yes</dd> }
        @if (device.DistributionStatus is not null) { <dt>Status</dt><dd>@device.DistributionStatus</dd> }
        <dt>GUDID record</dt><dd><a href="@device.GudidUrl">@device.DeviceId</a></dd>
    </dl>
    @if (device.GmdnDefinition is not null)
    {
        <p>@Clip(device.GmdnDefinition, 600)</p>
    }
    @if (device.Premarket.Count > 0)
    {
        <h3>FDA clearance or approval</h3>
        <div class="table-wrap">
            <table>
                <caption class="visually-hidden">Premarket decisions the device cites</caption>
                <thead><tr><th scope="col">Number</th><th scope="col">Kind</th><th scope="col">Device</th><th scope="col">Applicant</th><th scope="col">Decided</th></tr></thead>
                <tbody>
                    @foreach (var m in device.Premarket)
                    {
                        <tr>
                            <td><a href="@m.Url">@m.Number</a></td><td>@m.Kind</td><td class="long">@m.DeviceName</td><td>@m.Applicant</td>
                            <td>@m.DecisionDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="muted">A 510(k) clearance means FDA found the device substantially equivalent to one already on the market; a PMA approval follows FDA's review of clinical evidence (high-risk devices).</p>
    }
}

@if (p.Companies.Count > 0)
{
    <h2>Companies paying for it</h2>
    <div class="table-wrap">
        <table>
            <caption class="visually-hidden">Companies whose payments named the product</caption>
            <thead><tr><th scope="col">Company</th><th scope="col">Amount</th><th scope="col">Payments</th></tr></thead>
            <tbody>
                @foreach (var c in p.Companies)
                {
                    <tr><td><a href="/company/@Uri.EscapeDataString(c.CompanyId)">@c.Name</a></td><td>@Format.Money(c.Amount)</td><td>@Format.Number(c.Records)</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@if (p.ByNature.Count > 0)
{
    <h2>What the payments were for</h2>
    <div class="table-wrap">
        <table>
            <caption class="visually-hidden">Payments naming the product by kind</caption>
            <thead><tr><th scope="col">Kind of payment</th><th scope="col">Amount</th><th scope="col">Payments</th></tr></thead>
            <tbody>
                @foreach (var n in p.ByNature)
                {
                    <tr><td>@n.Nature</td><td>@Format.Money(n.Amount)</td><td>@Format.Number(n.Records)</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@if (p.TopSpecialties.Count > 0)
{
    <h2>Specialties paid the most</h2>
    <div class="table-wrap">
        <table>
            <caption class="visually-hidden">Specialties of the providers paid</caption>
            <thead><tr><th scope="col">Specialty</th><th scope="col">Providers</th><th scope="col">Amount</th></tr></thead>
            <tbody>
                @foreach (var s in p.TopSpecialties)
                {
                    <tr><td>@s.Specialty</td><td>@Format.Number(s.Providers)</td><td>@Format.Money(s.Amount)</td></tr>
                }
            </tbody>
        </table>
    </div>
    <p class="muted">Active providers by their primary specialty in NPPES.</p>
}

@if (p.TopProviders.Count > 0)
{
    <h2>Providers paid the most</h2>
    <p class="muted">The @p.TopProviders.Count active providers with the largest general payments naming this product in @p.Year.</p>
    <div class="table-wrap">
        <table>
            <caption class="visually-hidden">Providers paid the most in payments naming the product</caption>
            <thead><tr><th scope="col">Provider</th><th scope="col">Specialty</th><th scope="col">Location</th><th scope="col">Amount</th><th scope="col">Payments</th></tr></thead>
            <tbody>
                @foreach (var r in p.TopProviders)
                {
                    <tr>
                        <td><a href="/provider/@r.Npi">@r.Name</a>@if (r.Credential is not null){<span class="muted">, @r.Credential</span>}</td>
                        <td>@r.Specialty</td>
                        <td>@string.Join(", ", new[] { r.City, r.State }.Where(x => !string.IsNullOrWhiteSpace(x)))</td>
                        <td>@Format.Money(r.Amount)</td><td>@Format.Number(r.Records)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (p.Research is { } research)
{
    <h2>Research naming it (@research.Year)</h2>
    <p>
        <strong>@Format.Money(research.Amount)</strong> in @Format.Number(research.Records) research payment@(research.Records == 1 ? "" : "s")
        for @Format.Number(research.Studies) stud@(research.Studies == 1 ? "y" : "ies"), mostly to hospitals and research sites.
    </p>
    @if (research.TopStudies.Count > 0)
    {
        <div class="table-wrap">
            <table>
                <caption class="visually-hidden">The largest studies</caption>
                <thead><tr><th scope="col">Study</th><th scope="col">Sponsor</th><th scope="col">Amount</th><th scope="col">Payments</th></tr></thead>
                <tbody>
                    @foreach (var s in research.TopStudies)
                    {
                        <tr>
                            <td class="long">@(s.Study ?? s.NctId)@if (s.ClinicalTrialsUrl is not null){<text> </text><a href="@s.ClinicalTrialsUrl">@s.NctId</a>}</td>
                            <td>@if (s.CompanyId is not null){<a href="/company/@Uri.EscapeDataString(s.CompanyId)">@(s.CompanyName ?? s.CompanyId)</a>}</td>
                            <td>@Format.Money(s.Amount)</td><td>@Format.Number(s.Records)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@functions {
    // At most about max characters, cut at a space.
    private static string Clip(string text, int max) =>
        text.Length <= max ? text : text[..(text.LastIndexOf(' ', max) is > 0 and var i ? i : max)] + " …";
}

<p class="muted">
    Source: CMS Open Payments, @p.Year program year. A payment can name up to five products and counts for each, so amounts of different products
    can't be added up. Products are grouped by name as companies reported them (“Eliquis” and “ELIQUIS” are one product; “Eliquis 5 mg” is another).
    Verify at <a href="https://openpaymentsdata.cms.gov/">openpaymentsdata.cms.gov</a>.
</p>
