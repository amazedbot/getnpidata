@page "/company/{id}"
@using System.Globalization
@model CompanyModel
@{
    var c = Model.Company;
    ViewData["Title"] = c.Name;
    var years = c.Years;
    var showResearch = years.Any(y => y.Research > 0);
    var showOwnership = years.Any(y => y.OwnershipInvested > 0 || y.OwnershipValue > 0);
    var recipientResearch = c.TopProviders.Any(r => r.Research > 0);
    var recipientAssociated = c.TopProviders.Any(r => r.AssociatedResearch > 0);
    var recipientOwnership = c.TopProviders.Any(r => r.Ownership > 0);
}

<p><a href="/companies">‹ All companies</a></p>

<h1>@c.Name</h1>

<dl class="facts">
    @if (c.OtherNames.Count > 0)
    {
        <dt>Also reported as</dt><dd>@string.Join("; ", c.OtherNames)</dd>
    }
    @if (c.State is not null || c.Country is not null)
    {
        <dt>Located in</dt><dd>@string.Join(", ", new[] { c.State, c.Country }.Where(x => !string.IsNullOrWhiteSpace(x)))</dd>
    }
    <dt>Open Payments ID</dt><dd>@c.Id</dd>
    @if (c.FirstYear is not null)
    {
        <dt>Years reported</dt><dd>@c.FirstYear–@c.LastYear</dd>
    }
    @if (c.Providers is { } providers)
    {
        <dt>Providers paid</dt><dd>@Format.Number(providers) <span class="muted">(NPIs, all years)</span></dd>
    }
</dl>

<p>
    <strong>@Format.Money(c.General)</strong> in general payments (meals, consulting, speaking, travel, gifts …)
    @if (c.Research > 0)
    {
        <text>and <strong>@Format.Money(c.Research)</strong> in research payments</text>
    }
    to doctors, other prescribers and teaching hospitals@(c.FirstYear is null ? "" : $" in {c.FirstYear}–{c.LastYear}").
    @if (c.OwnershipValue > 0 || c.OwnershipInvested > 0)
    {
        <text>Physicians also reported ownership or investment interests in it worth <strong>@Format.Money(c.OwnershipValue)</strong>.</text>
    }
</p>
@{ var activeAgreements = c.IntegrityAgreements.Where(a => string.Equals(a.Status, "Effective", StringComparison.OrdinalIgnoreCase)).ToList(); }
@if (activeAgreements.Count > 0)
{
    <div class="notice alert" role="note">
        <strong>Under an HHS-OIG integrity agreement.</strong>
        An entity of this name agreed to OIG oversight after settling a federal health care fraud case
        (@string.Join("; ", activeAgreements.Select(a => a.Name))). See “Integrity agreements” below.
    </div>
}
<div class="notice" role="note">
    Companies that make drugs, devices and supplies must report what they give to doctors and teaching hospitals (the Sunshine Act).
    A payment is not evidence of wrongdoing, but it may matter to you as a patient: ask your provider about it if it does.
</div>

@if (years.Count > 0)
{
    <h2>Payments by year</h2>
    <div class="table-wrap">
        <table>
            <caption class="visually-hidden">The company's payments by program year</caption>
            <thead>
                <tr>
                    <th scope="col">Year</th><th scope="col">General payments</th>
                    @if (showResearch) { <th scope="col">Research</th> }
                    @if (showOwnership) { <th scope="col">Ownership invested</th><th scope="col">Ownership value</th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var y in years)
                {
                    <tr>
                        <td>@y.Year</td><td>@Format.Amount(y.General, y.GeneralRecords)</td>
                        @if (showResearch) { <td>@Format.Amount(y.Research, y.ResearchRecords)</td> }
                        @if (showOwnership) { <td>@Format.Amount(y.OwnershipInvested)</td><td>@Format.Amount(y.OwnershipValue)</td> }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="muted">Amount (number of payments).</p>
}

@if (c.ByNature.Count > 0)
{
    <h2>What the general payments were for (@c.DetailYear)</h2>
    <div class="table-wrap">
        <table>
            <caption class="visually-hidden">General payments by kind</caption>
            <thead><tr><th scope="col">Kind of payment</th><th scope="col">Amount</th><th scope="col">Payments</th></tr></thead>
            <tbody>
                @foreach (var n in c.ByNature)
                {
                    <tr><td>@n.Nature</td><td>@Format.Money(n.Amount)</td><td>@Format.Number(n.Records)</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@if (c.TopProducts.Count > 0)
{
    <h2>Products named in its payments (@c.DetailYear)</h2>
    <p class="muted">The drug, device or supply a payment was related to (the first one named), by general payments in @c.DetailYear.</p>
    <div class="table-wrap">
        <table>
            <caption class="visually-hidden">Products named in the company's general payments</caption>
            <thead><tr><th scope="col">Product</th><th scope="col">Type</th><th scope="col">Category</th><th scope="col">Amount</th><th scope="col">Payments</th></tr></thead>
            <tbody>
                @foreach (var p in c.TopProducts)
                {
                    <tr><td>@p.Name</td><td>@p.Kind</td><td>@p.Category</td><td>@Format.Money(p.Amount)</td><td>@Format.Number(p.Records)</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@if (c.TopSpecialties.Count > 0)
{
    <h2>Specialties it pays the most</h2>
    <div class="table-wrap">
        <table>
            <caption class="visually-hidden">Specialties of the providers the company paid, all years</caption>
            <thead><tr><th scope="col">Specialty</th><th scope="col">Providers</th><th scope="col">Amount, all kinds</th></tr></thead>
            <tbody>
                @foreach (var s in c.TopSpecialties)
                {
                    <tr><td>@s.Specialty</td><td>@Format.Number(s.Providers)</td><td>@Format.Money(s.Amount)</td></tr>
                }
            </tbody>
        </table>
    </div>
    <p class="muted">Active providers by their primary specialty in NPPES, over every published year.</p>
}

@if (c.TopProviders.Count > 0)
{
    <h2>Providers it paid the most</h2>
    <p class="muted">The @c.TopProviders.Count active providers with the largest amounts of any kind from this company, over every published year.</p>
    <div class="table-wrap">
        <table>
            <caption class="visually-hidden">The providers the company paid the most</caption>
            <thead>
                <tr>
                    <th scope="col">Provider</th><th scope="col">Specialty</th><th scope="col">Location</th><th scope="col">General</th>
                    @if (recipientResearch) { <th scope="col">Research</th> }
                    @if (recipientAssociated) { <th scope="col" title="Research funding paid to an institution where this provider was a principal investigator">Research as investigator</th> }
                    @if (recipientOwnership) { <th scope="col">Ownership</th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var r in c.TopProviders)
                {
                    <tr>
                        <td><a href="/provider/@r.Npi">@r.Name</a>@if (r.Credential is not null){<span class="muted">, @r.Credential</span>}</td>
                        <td>@r.Specialty</td>
                        <td>@string.Join(", ", new[] { r.City, r.State }.Where(x => !string.IsNullOrWhiteSpace(x)))</td>
                        <td>@Format.Amount(r.General)</td>
                        @if (recipientResearch) { <td>@Format.Amount(r.Research)</td> }
                        @if (recipientAssociated) { <td>@Format.Amount(r.AssociatedResearch)</td> }
                        @if (recipientOwnership) { <td>@Format.Amount(r.Ownership)</td> }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (c.Recalls is { } recalls)
{
    <h2>FDA recalls</h2>
    <p>
        <strong>@Format.Number(recalls.Total)</strong> drug and device recall@(recalls.Total == 1 ? "" : "s") since 2004
        (Class I, the most serious: @Format.Number(recalls.ClassI); Class II: @Format.Number(recalls.ClassII); Class III: @Format.Number(recalls.ClassIII))@(recalls.Ongoing > 0 ? $", {Format.Number(recalls.Ongoing)} listed by FDA as ongoing" : "").
        Recalling firm: @string.Join("; ", recalls.Firms).
    </p>
    <div class="table-wrap">
        <table>
            <caption class="visually-hidden">The newest FDA recalls</caption>
            <thead><tr><th scope="col">Started</th><th scope="col">Recall</th><th scope="col">Class</th><th scope="col">Status</th><th scope="col">Product</th><th scope="col">Reason</th></tr></thead>
            <tbody>
                @foreach (var r in recalls.Latest)
                {
                    <tr>
                        <td>@r.Initiated?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                        <td>@r.RecallNumber <span class="muted">(@(r.ProductType == "Devices" ? "device" : "drug"))</span></td>
                        <td>@r.Classification</td><td>@r.Status</td>
                        <td class="long">@r.Product</td><td class="long">@r.Reason</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="muted">
        The newest @recalls.Latest.Count, from FDA enforcement reports (openFDA), matched to this company by the recalling firm's name; a firm of the
        same name is not always the same company. Class I: may cause serious harm or death; Class II: temporary or reversible harm; Class III: unlikely to cause harm.
        Search every recall at <a href="https://www.accessdata.fda.gov/scripts/ires/index.cfm">FDA's Enforcement Report</a>.
    </p>
}

@if (c.SecListings.Count > 0)
{
    <h2>Public company (SEC)</h2>
    <ul>
        @foreach (var s in c.SecListings)
        {
            <li><a href="@s.EdgarUrl">@s.Name</a>: @s.Ticker@(s.Exchange is null ? "" : $" on {s.Exchange}") <span class="muted">· SEC CIK @s.Cik</span></li>
        }
    </ul>
    <p class="muted">SEC EDGAR registrants of the same name, with their filings (annual reports, ownership). A name match: a parent or subsidiary under another name isn't found.</p>
}

@if (c.IntegrityAgreements.Count > 0)
{
    <h2>Integrity agreements (HHS-OIG)</h2>
    <div class="table-wrap">
        <table>
            <caption class="visually-hidden">OIG integrity agreements</caption>
            <thead><tr><th scope="col">Agreement with</th><th scope="col">Type</th><th scope="col">Status</th><th scope="col">Location</th></tr></thead>
            <tbody>
                @foreach (var a in c.IntegrityAgreements)
                {
                    <tr>
                        <td><a href="@a.Url">@a.Name</a></td><td>@a.Type</td>
                        <td>@a.Status @a.StatusDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td><td>@a.Location</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="muted">Companies that settle federal health care fraud cases may agree to years of OIG oversight (a Corporate Integrity Agreement). Matched to this company by name. Details at <a href="https://oig.hhs.gov/compliance/corporate-integrity-agreements/">oig.hhs.gov</a>.</p>
}

@if (c.SimilarNames.Count > 0)
{
    <h2>Similar company names</h2>
    <p class="muted">Companies often report under several entities (a U.S. sales arm, a research unit, a subsidiary). These share a word of this name and may be related; this is a name match only.</p>
    <ul>
        @foreach (var s in c.SimilarNames)
        {
            <li><a href="/company/@Uri.EscapeDataString(s.Id)">@s.Name</a> <span class="muted">· @Format.Amount(s.Payments)@(s.Providers is { } n ? $" · {Format.Number(n)} providers" : "")</span></li>
        }
    </ul>
}

<p class="muted">
    Sources: CMS Open Payments, every published program year (the products and kinds of payment: @(c.DetailYear?.ToString(CultureInfo.InvariantCulture) ?? "the newest year")).
    Ownership is the value of an ownership or investment interest (as reported), not a payment.
    See the company's own record at <a href="@c.OpenPaymentsUrl">openpaymentsdata.cms.gov</a>.
</p>
