# Copy to .env (git-ignored) and replace every password. docker-compose.yml reads it; scripts/setup-secrets.ps1 -Docker too.
MYSQL_ROOT_PASSWORD=change-me-root
NPI_LOADER_PASSWORD=change-me-loader
NPI_WEB_PASSWORD=change-me-web
NPI_TEST_PASSWORD=change-me-test
# Optional
NPI_DATABASE=npi
MYSQL_PORT=3306
MYSQL_BUFFER_POOL=4G
